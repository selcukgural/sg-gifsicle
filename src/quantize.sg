//
// Where gifsicle's arithmetic of floating point sums products, clang fuses it as it builds gifsicle
// on macOS: in `a*b + c*d + e*f`, the first product is fused with the rounded second, then the
// third is fused in. The port writes each such fusion out with `fusedMultiplyAdd`.

// ---- C's random(): gifsicle never seeds it ----

// The generator of random() in the C libraries of macOS (FreeBSD's) and Linux (GNU's), which agree:
// an additive feedback generator of 31 words, as srandom(1) leaves it.
struct CRandom {
    List<uint> state
    nint f
    nint r
}

uint cRandomGoodRand(uint ctx) {
    int x = ctx.wrappingToInt()
    // can't be initialized with 0, so use another value
    if x == 0 {
        x = 123459876
    }
    int hi = x / 127773
    int lo = x % 127773
    x = 16807 * lo - 2836 * hi
    if x < 0 {
        x += 0x7FFFFFFF
    }
    return x.wrappingToUint()
}

CRandom newCRandom() {
    var rs = CRandom { state = List<uint>.repeat(0, 31), f = 3, r = 0 }
    rs.state[0] = 1
    for i in 1..31 {
        rs.state[i] = cRandomGoodRand(rs.state[i - 1])
    }
    for _ in 0..310 {
        _ = cRandom(ref rs)
    }
    return rs
}

// the next number, from 0 to 2^31 - 1
long cRandom(ref CRandom rs) {
    rs.state[rs.f] = rs.state[rs.f].wrappingAdd(rs.state[rs.r])
    long v = (long)((rs.state[rs.f] >> 1) & 0x7FFFFFFF)
    rs.f += 1
    if rs.f >= 31 {
        rs.f = 0
        rs.r += 1
    } else {
        rs.r += 1
        if rs.r >= 31 {
            rs.r = 0
        }
    }
    return v
}

// ---- COLORMAP FUNCTIONS return a palette (a vector of Gif_Colors). The pixel fields are
// undefined; the haspixel fields are all 0. ----

struct AdaptiveSlot : Copyable {
    int first
    int size
    uint pixel
}

// sorts `kch.h[first..first + size]` by the component `k` of its colors, as C's qsort does
void kchistSortSlice(ref Kchist kch, int first, int size, int k) {
    nint n = (nint)size
    nint at = (nint)first
    var perm = List<int>.repeat(0, n)
    var key = List<long>.repeat(0, n)
    for i in 0..n {
        perm[i] = (int)i
        key[i] = (long)kch.h[at + i].ka.a[k]
    }
    sortPerm(ref perm, 0, n, read key)
    var sorted = List<KchistItem>.withCapacity(n)
    for i in 0..n {
        sorted.add(kch.h[at + (nint)perm[i]])
    }
    for i in 0..n {
        kch.h[at + i] = sorted[i]
    }
}

nint colormapMedianCut(ref Gt g, ref Kchist kch, ref OutputData od) {
    int adaptSize = od.colormapSize
    var slots = List<AdaptiveSlot>.repeat(AdaptiveSlot { first = 0, size = 0, pixel = 0 }, (nint)adaptSize)
    var gfcm = gifNewFullColormap(ref g, adaptSize, 256)
    int nadapt = 0

    // This code was written with reference to ppmquant by Jef Poskanzer, part of the pbmplus
    // package.

    if adaptSize >= kch.n && od.colormapFixed == None {
        var word = "colors"
        if kch.n == 1 {
            word = "color"
        }
        warning(ref g, 1, "trivial adaptive palette (only %d %s in source)", read List<string> { $"{kch.n}".toString(), word })
    }
    if adaptSize >= kch.n {
        adaptSize = kch.n
    }

    // 0. remove any transparent color from consideration; reduce adaptive palette size to
    // accommodate transparency if it looks like that'll be necessary
    if adaptSize > 2 && adaptSize < kch.n && kch.n <= 265 && od.colormapNeedsTransparency {
        adaptSize -= 1
    }

    // 1. set up the first slot, containing all pixels.
    slots[0].first = 0
    slots[0].size = kch.n
    slots[0].pixel = 0
    for i in 0..(nint)kch.n {
        slots[0].pixel = slots[0].pixel.wrappingAdd(kch.h[i].count)
    }

    // 2. split slots until we have enough.
    nadapt = 1
    while nadapt < adaptSize {
        // 2.1. pick the slot to split.
        int split = -1
        uint splitPixel = 0
        for i in 0..(nint)nadapt {
            if slots[i].size >= 2 && slots[i].pixel > splitPixel {
                split = (int)i
                splitPixel = slots[i].pixel
            }
        }
        if split < 0 {
            break
        }
        nint sp = (nint)split
        nint slice = (nint)slots[sp].first
        int size = slots[sp].size

        // 2.2. find its extent.
        var minc = kacK(kch.h[slice].ka)
        var maxc = minc
        for i in 1..(nint)size {
            for k in 0..3 {
                int v = (int)kch.h[slice + i].ka.a[k]
                minc.a[k] = (short)kcMin((int)minc.a[k], v)
                maxc.a[k] = (short)kcMax((int)maxc.a[k], v)
            }
        }

        // 2.3. decide how to split it. use the luminance method. also sort the colors.
        double redDiff = 0.299 * (double)((int)maxc.a[0] - (int)minc.a[0])
        double greenDiff = 0.587 * (double)((int)maxc.a[1] - (int)minc.a[1])
        double blueDiff = 0.114 * (double)((int)maxc.a[2] - (int)minc.a[2])
        if redDiff >= greenDiff && redDiff >= blueDiff {
            kchistSortSlice(ref kch, slots[sp].first, size, 0)
        } else if greenDiff >= blueDiff {
            kchistSortSlice(ref kch, slots[sp].first, size, 1)
        } else {
            kchistSortSlice(ref kch, slots[sp].first, size, 2)
        }

        // 2.4. decide where to split the slot and split it there.
        uint halfPixels = slots[sp].pixel / 2
        uint pixelAccum = kch.h[slice].count
        int i = 1
        while i < size - 1 && pixelAccum < halfPixels {
            pixelAccum = pixelAccum.wrappingAdd(kch.h[slice + (nint)i].count)
            i += 1
        }

        // We know the area before the split has more pixels than the area after, possibly by a
        // large margin (bad news). If it would shrink the margin, change the split.
        uint diff1 = pixelAccum.wrappingMultiply(2).wrappingSubtract(slots[sp].pixel)
        uint diff2 = slots[sp].pixel.wrappingSubtract(pixelAccum.wrappingSubtract(kch.h[slice + (nint)i - 1].count).wrappingMultiply(2))
        if diff2 < diff1 && i > 1 {
            i -= 1
            pixelAccum = pixelAccum.wrappingSubtract(kch.h[slice + (nint)i].count)
        }

        nint na = (nint)nadapt
        slots[na].first = slots[sp].first + i
        slots[na].size = size - i
        slots[na].pixel = slots[sp].pixel.wrappingSubtract(pixelAccum)
        slots[sp].size = i
        slots[sp].pixel = pixelAccum
        nadapt += 1
    }

    // 3. make the new palette by choosing one color from each slot.
    for i in 0..(nint)nadapt {
        var px = double[3](0.0)
        nint slice = (nint)slots[i].first
        uint pixel = slots[i].pixel
        if pixel == 0 {
            pixel = 1
        }
        for j in 0..(nint)slots[i].size {
            double count = (double)kch.h[slice + j].count
            for k in 0..3 {
                px[k] = ((double)kch.h[slice + j].ka.a[k]).fusedMultiplyAdd(count, px[k])
            }
        }
        var kc = kcolor((int)(px[0] / (double)pixel), (int)(px[1] / (double)pixel), (int)(px[2] / (double)pixel))
        g.colormaps[gfcm].col[i] = kcTogfcg(read g.kc, kc)
    }

    g.colormaps[gfcm].ncol = nadapt
    return gfcm
}

struct Kcdiversity {
    List<int> closest
    List<uint> minDist
    bool dither
    List<uint> minDitherDist
    List<int> chosen
    int nchosen
}

// sorts the histogram by popularity, most popular first
Kcdiversity kcdiversityInit(ref Kchist kch, bool dodither) {
    nint n = (nint)kch.n
    var perm = List<int>.repeat(0, n)
    var key = List<long>.repeat(0, n)
    for i in 0..n {
        perm[i] = (int)i
        key[i] = -(long)kch.h[i].count
    }
    sortPerm(ref perm, 0, n, read key)
    var sorted = List<KchistItem>.withCapacity(n)
    for i in 0..n {
        sorted.add(kch.h[(nint)perm[i]])
    }
    for i in 0..n {
        kch.h[i] = sorted[i]
    }
    var minDitherDist = List<uint>()
    if dodither {
        minDitherDist = List<uint>.repeat(0xFFFFFFFF, n)
    }
    return Kcdiversity { closest = List<int>.repeat(0, n), minDist = List<uint>.repeat(0xFFFFFFFF, n), dither = dodither,
        minDitherDist = minDitherDist, chosen = List<int>.repeat(0, n), nchosen = 0 }
}

int kcdiversityFindPopular(read Kcdiversity div, read Kchist kch) {
    int i = 0
    while i != kch.n && div.minDist[(nint)i] == 0 {
        i += 1
    }
    return i
}

int kcdiversityFindDiverse(read Kcdiversity div, read Kchist kch, double ditherweight) {
    int n = kch.n
    int chosen = kcdiversityFindPopular(div, kch)
    if chosen == n {
        return chosen
    }
    if ditherweight == 0.0 || !div.dither {
        for i in chosen + 1..n {
            if div.minDist[(nint)i] > div.minDist[(nint)chosen] {
                chosen = i
            }
        }
    } else {
        double maxDist = ditherweight.fusedMultiplyAdd((double)div.minDitherDist[(nint)chosen], (double)div.minDist[(nint)chosen])
        for i in chosen + 1..n {
            if div.minDist[(nint)i] != 0 {
                double dist = ditherweight.fusedMultiplyAdd((double)div.minDitherDist[(nint)i], (double)div.minDist[(nint)i])
                if dist > maxDist {
                    chosen = i
                    maxDist = dist
                }
            }
        }
    }
    return chosen
}

int kcdiversityChoose(ref Kcdiversity div, read Kchist kch, int chosen, bool dodither) {
    nint n = (nint)kch.n
    nint c = (nint)chosen
    div.minDist[c] = 0
    if div.dither {
        div.minDitherDist[c] = 0
    }
    div.closest[c] = chosen

    // adjust the min_dist array
    var at = kacK(kch.h[c].ka)
    for i in 0..n {
        if div.minDist[i] != 0 {
            uint dist = kcDistance(kacK(kch.h[i].ka), at)
            if dist < div.minDist[i] {
                div.minDist[i] = dist
                div.closest[i] = chosen
            }
        }
    }

    // also account for dither distances
    if dodither && div.dither {
        for i in 0..(nint)div.nchosen {
            var x = at
            var y = kacK(kch.h[(nint)div.chosen[i]].ka)
            // penalize combinations with large luminance difference
            double dL = (double)(kcLuminance(x) - kcLuminance(y)).abs()
            if dL > 8192.0 {
                dL = dL * 4.0 / 32767.0
            } else {
                dL = 1.0
            }
            // create combination
            for k in 0..3 {
                x.a[k] = (short)(((int)x.a[k] + (int)y.a[k]) >> 1)
            }
            // track closeness of combination to other colors
            for j in 0..n {
                if div.minDist[j] != 0 {
                    double dist = (double)kcDistance(kacK(kch.h[j].ka), x) * dL
                    if dist < (double)div.minDitherDist[j] {
                        div.minDitherDist[j] = (uint)dist
                    }
                }
            }
        }
    }

    div.chosen[(nint)div.nchosen] = chosen
    div.nchosen += 1
    return chosen
}

// Each chosen color moves to the mean of the colors closest to it, its own counted thrice. C sums in
// a vector of floats, each lane `(float)((double)x + component * count)`, fused.
void colormapDiversityDoBlend(ref Kcdiversity div, ref Kchist kch) {
    nint n = (nint)kch.n
    nint nchosen = (nint)div.nchosen
    var chosenmap = List<int>.repeat(0, n)
    var di = List<ScaleColor>.repeat(scZero(), nchosen)
    for i in 0..nchosen {
        chosenmap[(nint)div.chosen[i]] = (int)i
    }
    for i in 0..n {
        double count = (double)kch.h[i].count
        if div.closest[i] == (int)i {
            count *= 3.0
        }
        nint j = (nint)chosenmap[(nint)div.closest[i]]
        for k in 0..3 {
            di[j].a[k] = (float)((double)kch.h[i].ka.a[k]).fusedMultiplyAdd(count, (double)di[j].a[k])
        }
        di[j].a[3] = (float)(count + (double)di[j].a[3])
    }
    for i in 0..nchosen {
        nint chosen = (nint)div.chosen[i]
        if di[i].a[3] >= (float)kch.h[chosen].count.wrappingMultiply(5) {
            for k in 0..3 {
                kch.h[chosen].ka.a[k] = ((int)(di[i].a[k] / di[i].a[3])).wrappingToShort()
            }
        }
    }
}

nint colormapDiversity(ref Gt g, ref Kchist kch, read OutputData od, bool blend0) {
    int adaptSize = od.colormapSize
    var gfcm = gifNewFullColormap(ref g, adaptSize, 256)
    bool blend = blend0

    // This code uses XV's modified diversity algorithm, and was written with reference to XV's
    // implementation of that algorithm by John Bradley and Tom Lane.

    if adaptSize > kch.n && od.colormapFixed == None {
        warning(ref g, 1, "trivial adaptive palette (only %d colors in source)", read List<string> { $"{kch.n}".toString() })
    }
    if adaptSize > kch.n {
        adaptSize = kch.n
    }

    // 0. remove any transparent color from consideration; reduce adaptive palette size to
    // accommodate transparency if it looks like that'll be necessary. It will be necessary to
    // accommodate transparency if (1) there is transparency in the image; (2) the adaptive
    // palette isn't trivial; and (3) there are a small number of colors in the image (arbitrary
    // constant: <= 265), so it's likely that most images will use most of the slots, so it's
    // likely there won't be unused slots.
    if adaptSize > 2 && adaptSize < kch.n && kch.n <= 265 && od.colormapNeedsTransparency {
        adaptSize -= 1
    }

    // blending has bad effects when there are very few colors
    if adaptSize < 4 {
        blend = false
    }

    // 1. initialize min_dist and sort the colors in order of popularity.
    var div = kcdiversityInit(ref kch, od.ditherType != DitherNone)

    // 2. choose colors one at a time
    for nadapt in 0..adaptSize {
        int chosen = 0
        // 2.1. choose the color to be added
        if nadapt == 0 || (nadapt >= 10 && nadapt % 2 == 0) {
            // 2.1a. want most popular unchosen color
            chosen = kcdiversityFindPopular(read div, read kch)
        } else if od.ditherType == DitherNone {
            // 2.1b. choose based on diversity from unchosen colors
            chosen = kcdiversityFindDiverse(read div, read kch, 0.0)
        } else {
            // 2.1c. choose based on diversity from unchosen colors, but allow dithered
            // combinations to stand in for colors, particularly early on in the color finding
            // process. Weight assigned to dithered combinations drops as we proceed. C's
            // `pow(0.25, y)` is `exp2(y * -2)` as clang builds it.
            double y = 1.0 + (double)(nadapt - 1) / 3.0
            double ditherweight = 0.05 + (y * -2.0).exp2()
            chosen = kcdiversityFindDiverse(read div, read kch, ditherweight)
        }
        _ = kcdiversityChoose(ref div, read kch, chosen, od.ditherType != DitherNone && nadapt > 0 && nadapt < 64)
    }

    // 3. make the new palette by choosing one color from each slot.
    if blend {
        colormapDiversityDoBlend(ref div, ref kch)
    }

    for nadapt in 0..(nint)div.nchosen {
        g.colormaps[gfcm].col[nadapt] = kcTogfcg(read g.kc, kacK(kch.h[(nint)div.chosen[nadapt]].ka))
    }
    g.colormaps[gfcm].ncol = div.nchosen
    return gfcm
}

nint colormapBlendDiversity(ref Gt g, ref Kchist kch, ref OutputData od) {
    return colormapDiversity(ref g, ref kch, read od, true)
}

nint colormapFlatDiversity(ref Gt g, ref Kchist kch, ref OutputData od) {
    return colormapDiversity(ref g, ref kch, read od, false)
}

// ---- mapping an image to a new colormap ----

void colormapImagePosterize(ref Gt g, read Image gfi, ref List<byte> newData, ref Colormap oldCm, ref Kd3Tree kd3,
        ref List<uint> histogram) {
    nint ncol = (nint)oldCm.ncol
    var map = int[256](0)
    int transparent = gfi.transparent

    // find closest colors in new colormap
    for i in 0..ncol {
        var c = oldCm.col[i]
        int p = kd3Closest8g(read g.kc, ref kd3, (int)c.red, (int)c.green, (int)c.blue)
        map[i] = p
        oldCm.col[i].pixel = p.wrappingToUint()
        oldCm.col[i].haspixel = 1
    }
    for i in ncol..256 {
        map[i] = 0
        oldCm.col[i].pixel = 0
        oldCm.col[i].haspixel = 1
    }

    // map image
    nint width = (nint)gfi.width
    nint nd = 0
    for j in 0..(nint)gfi.height {
        nint row = gfi.rows[j]
        for i in 0..width {
            byte d = gfi.data[row + i]
            if (int)d != transparent {
                byte p = map[(nint)d].wrappingToByte()
                newData[nd] = p
                histogram[(nint)p] += 1
            }
            nd += 1
        }
    }
}

const int DitherScale = 1024
const int DitherShift = 10
const int DitherScaleM1 = DitherScale - 1
const int DitherItem2err = 1 << (DitherShift - 7)
const nint NRandomValues = 512

// The same random values on each call, in an attempt to minimize "jumping dithering" effects on
// animations; each dither makes its own the first time, from C's random().
List<int> makeRandomValues(ref CRandom rs) {
    var values = List<int>.repeat(0, NRandomValues)
    for i in 0..NRandomValues {
        values[i] = (int)(cRandom(ref rs) % (long)(DitherScaleM1 * 2)) - DitherScaleM1
    }
    return values
}

// the colors of `oldCm` as `kd3` sees them, and each one's closest color in `kd3` as its pixel
List<Kcolor> ditherOldKcs(ref Gt g, ref Colormap oldCm, ref Kd3Tree kd3) {
    var oldKc = List<Kcolor>.repeat(kcolor(0, 0, 0), oldCm.col.length())
    for i in 0..(nint)oldCm.ncol {
        oldKc[i] = kd3Makegfcg(read g.kc, read kd3, oldCm.col[i])
        uint dist = 0
        oldCm.col[i].pixel = kd3ClosestTransformed(ref kd3, oldKc[i], ref dist).wrappingToUint()
        oldCm.col[i].haspixel = 1
    }
    for i in (nint)oldCm.ncol..256 {
        oldKc[i] = kd3Make8g(read g.kc, read kd3, 0, 0, 0)
        oldCm.col[i].pixel = 0
        oldCm.col[i].haspixel = 1
    }
    return oldKc
}

// the color of `kd3` for `use`: the one `oldPixel` stands for if `use` is within its radius
byte ditherPick(ref Kd3Tree kd3, uint oldPixel, Kcolor use1) {
    nint e = (nint)oldPixel
    if kcDistance(kd3.ks[e], use1) < kd3.xradius[e] {
        return (byte)e
    }
    uint dist = 0
    return kd3ClosestTransformed(ref kd3, use1, ref dist).wrappingToByte()
}

void colormapImageFloydSteinberg(ref Gt g, read Image gfi, ref List<byte> allNewData, ref Colormap oldCm, ref Kd3Tree kd3,
        ref List<uint> histogram) {
    nint width = (nint)gfi.width
    bool ditherDirection = false
    int transparent = gfi.transparent

    // Initialize distances; beware uninitialized colors
    var oldKc = ditherOldKcs(ref g, ref oldCm, ref kd3)

    // This code was written with reference to ppmquant by Jef Poskanzer, part of the pbmplus
    // package.

    // Initialize Floyd-Steinberg error vectors to small random values, so we don't get artifacts
    // on the top row
    var err = List<Wkcolor>.repeat(wkcZero(), width + 2)
    var err1 = List<Wkcolor>.repeat(wkcZero(), width + 2)
    if g.fsRandomValues.length() == 0 {
        g.fsRandomValues = makeRandomValues(ref g.random)
    }
    for i in 0..width + 2 {
        nint j = (i + (nint)gfi.left) * 3
        for k in 0..3 {
            err[i].a[k] = g.fsRandomValues[(j + k) % NRandomValues]
        }
    }
    // err1 initialized below

    kd3BuildXradius(ref kd3)

    // Do the image!
    for j in 0..(nint)gfi.height {
        // used for error diffusion
        nint d0 = 2
        nint d1 = 0
        nint d2 = 1
        nint d3 = 2
        nint x = 0
        if ditherDirection {
            x = width - 1
            d0 = 0
            d1 = 2
            d2 = 1
            d3 = 0
        }
        nint row = gfi.rows[j]
        nint newRow = j * width

        for i in 0..width + 2 {
            err1[i] = wkcZero()
        }

        // Do a single row
        while x >= 0 && x < width {
            byte d = gfi.data[row + x]
            // the transparent color never gets adjusted
            if (int)d != transparent {
                // find desired new color
                var use1 = oldKc[(nint)d]

                // use Floyd-Steinberg errors to adjust
                for k in 0..3 {
                    int v = (int)use1.a[k] + (err[x + 1].a[k] & ~(DitherItem2err - 1)) / DitherItem2err
                    use1.a[k] = (short)kcClampv(v)
                }

                byte p = ditherPick(ref kd3, oldCm.col[(nint)d].pixel, use1)
                allNewData[newRow + x] = p
                histogram[(nint)p] += 1

                // calculate and propagate the error between desired and selected color. Assume
                // that, with a large scale (1024), we don't need to worry about image artifacts
                // caused by error accumulation (the fact that the error terms might not sum to
                // the error).
                for k in 0..3 {
                    int e = ((int)use1.a[k] - (int)kd3.ks[(nint)p].a[k]) * DitherItem2err
                    if e != 0 {
                        err[x + d0].a[k] += ((e * 7) & ~15) / 16
                        err1[x + d1].a[k] += ((e * 3) & ~15) / 16
                        err1[x + d2].a[k] += ((e * 5) & ~15) / 16
                        err1[x + d3].a[k] += (e & ~15) / 16
                    }
                }
            }
            if ditherDirection {
                x -= 1
            } else {
                x += 1
            }
        }
        // Did a single row

        // change dithering directions
        var temp = err1.replace(List<Wkcolor>())
        err1 = err.replace(List<Wkcolor>())
        err = temp
        ditherDirection = !ditherDirection
    }
}

// A variant of the Floyd-Steinberg dither, as the Atkinson dither is a variant of it.
void colormapImageAtkinson(ref Gt g, read Image gfi, ref List<byte> allNewData, ref Colormap oldCm, ref Kd3Tree kd3,
        ref List<uint> histogram) {
    nint width = (nint)gfi.width
    int transparent = gfi.transparent

    // Initialize distances; beware uninitialized colors
    var oldKc = ditherOldKcs(ref g, ref oldCm, ref kd3)

    // Initialize Atkinson error vectors. As in Floyd-Steinberg, the error for pixel x is stored at
    // index x+1; the extra slots catch errors propagated past the image edges.
    var err0 = List<Wkcolor>.repeat(wkcZero(), width + 3)
    var err1 = List<Wkcolor>.repeat(wkcZero(), width + 3)
    var err2 = List<Wkcolor>.repeat(wkcZero(), width + 3)

    if g.atkinsonRandomValues.length() == 0 {
        g.atkinsonRandomValues = makeRandomValues(ref g.random)
    }
    for i in 0..width + 3 {
        nint j = (i + (nint)gfi.left) * 3
        for k in 0..3 {
            err0[i].a[k] = g.atkinsonRandomValues[(j + k) % NRandomValues]
        }
    }

    kd3BuildXradius(ref kd3)

    // Do the image!
    for j in 0..(nint)gfi.height {
        nint row = gfi.rows[j]
        nint newRow = j * width

        // Initialize the error row two rows down; err1 already holds errors propagated from the
        // previous rows
        for i in 0..width + 3 {
            err2[i] = wkcZero()
        }

        for x in 0..width {
            byte d = gfi.data[row + x]
            // Transparent color never gets adjusted, skip
            if (int)d == transparent {
                continue
            }

            // Calculate desired new color including current error
            var use1 = oldKc[(nint)d]
            for k in 0..3 {
                use1.a[k] = (short)kcClampv((int)use1.a[k] + err0[x + 1].a[k] / DitherScale)
            }

            // Find the closest color in the colormap
            byte p = ditherPick(ref kd3, oldCm.col[(nint)d].pixel, use1)
            allNewData[newRow + x] = p
            histogram[(nint)p] += 1

            // Calculate and propagate the error using the Atkinson dithering algorithm
            for k in 0..3 {
                int e = ((int)use1.a[k] - (int)kd3.ks[(nint)p].a[k]) * DitherScale
                err0[x + 2].a[k] += e / 8
                err0[x + 3].a[k] += e / 8
                err1[x].a[k] += e / 8
                err1[x + 1].a[k] += e / 8
                err1[x + 2].a[k] += e / 8
                err2[x + 1].a[k] += e / 8
            }
        }

        // Rotate error buffers
        var temp = err0.replace(List<Wkcolor>())
        err0 = err1.replace(List<Wkcolor>())
        err1 = err2.replace(List<Wkcolor>())
        err2 = temp
    }
}

// ---- ordered dithering ----

struct OdselectPlanitem : Copyable {
    byte plan
    int frac
}

void planFromCplan(ref List<byte> plan, nint at, int nplan, read List<OdselectPlanitem> cp, int ncp, int whole) {
    int cfracSubt = 0
    int planpos = 0
    for i in 0..(nint)ncp {
        cfracSubt += cp[i].frac
        int endPlanpos = cfracSubt * nplan / whole
        while planpos != endPlanpos {
            plan[at + (nint)planpos] = cp[i].plan
            planpos += 1
        }
    }
}

// The point of the segment from `p0` to `p1` closest to `want`, if it is inside: `t` places it on
// the segment and `dist` is its distance.
bool kcLineClosest(Kcolor p0, Kcolor p1, Kcolor want, ref double t, ref uint dist) {
    var p01 = wkcZero()
    var p0ref = wkcZero()
    for d in 0..3 {
        p01.a[d] = (int)p1.a[d] - (int)p0.a[d]
        p0ref.a[d] = (int)want.a[d] - (int)p0.a[d]
    }
    uint den = kcDistance(p0, p1)
    if den == 0 {
        return false
    }
    // NB: We've run out of bits of precision. We can calculate the denominator in unsigned
    // arithmetic, but the numerator might be negative, or it might be so large that it is
    // unsigned. Calculate the numerator as a double. (C multiplies the second and third terms as
    // ints.)
    double num = ((double)p01.a[0]).fusedMultiplyAdd((double)p0ref.a[0], (double)(p01.a[1] * p0ref.a[1]))
    t = (num + (double)(p01.a[2] * p0ref.a[2])) / (double)den
    if t < 0.0 || t > 1.0 {
        return false
    }
    var online = kcolor(0, 0, 0)
    for d in 0..3 {
        int v = (int)((double)p01.a[d] * t) + (int)p0.a[d]
        online.a[d] = (short)kcClampv(v)
    }
    dist = kcDistance(online, want)
    return true
}

// x*a + y*b + z*c, as clang fuses it
double dot3(double x, double a, double y, double b, double z, double c) {
    return z.fusedMultiplyAdd(c, x.fusedMultiplyAdd(a, y * b))
}

// x*a - y*b, as clang fuses it
double crossTerm(double x, double a, double y, double b) {
    return x.fusedMultiplyAdd(a, -(y * b))
}

// The point of the triangle `p0`, `p1`, `p2` closest to `want`, if it is inside and closer than any
// point along its edges: `t0` and `t1` give its barycentric coordinates and `dist` its distance.
bool kcPlaneClosest(Kcolor p0, Kcolor p1, Kcolor p2, Kcolor want, ref double t0, ref double t1, ref uint dist) {
    var p0ref = wkcZero()
    var p01 = wkcZero()
    var p02 = wkcZero()

    // Calculate the non-unit normal of the plane determined by the input colors (p0-p2)
    for d in 0..3 {
        p0ref.a[d] = (int)want.a[d] - (int)p0.a[d]
        p01.a[d] = (int)p1.a[d] - (int)p0.a[d]
        p02.a[d] = (int)p2.a[d] - (int)p0.a[d]
    }
    double n0 = (double)(p01.a[1] * p02.a[2] - p01.a[2] * p02.a[1])
    double n1 = (double)(p01.a[2] * p02.a[0] - p01.a[0] * p02.a[2])
    double n2 = (double)(p01.a[0] * p02.a[1] - p01.a[1] * p02.a[0])

    // Moeller-Trumbore ray tracing algorithm: trace a ray from `want` along normal `n`; convert to
    // barycentric coordinates to see if the ray intersects with the triangle.
    double pvec0 = crossTerm(n1, (double)p02.a[2], n2, (double)p02.a[1])
    double pvec1 = crossTerm(n2, (double)p02.a[0], n0, (double)p02.a[2])
    double pvec2 = crossTerm(n0, (double)p02.a[1], n1, (double)p02.a[0])

    double det = dot3(pvec0, (double)p01.a[0], pvec1, (double)p01.a[1], pvec2, (double)p01.a[2])
    if det.abs() <= 0.0001220703125 {
        return false
    }
    det = 1.0 / det

    double u = dot3((double)p0ref.a[0], pvec0, (double)p0ref.a[1], pvec1, (double)p0ref.a[2], pvec2) * det
    if u < 0.0 || u > 1.0 {
        return false
    }

    double q0 = (double)(p0ref.a[1] * p01.a[2] - p0ref.a[2] * p01.a[1])
    double q1 = (double)(p0ref.a[2] * p01.a[0] - p0ref.a[0] * p01.a[2])
    double q2 = (double)(p0ref.a[0] * p01.a[1] - p0ref.a[1] * p01.a[0])

    double v = dot3(n0, q0, n1, q1, n2, q2) * det
    if v < 0.0 || v > 1.0 || u + v > 1.0 {
        return false
    }

    // Now we know at there is a point in the triangle that is closer to `want` than any point
    // along its edges. Return the barycentric coordinates for that point and the distance to that
    // point.
    t0 = u
    t1 = v
    v = dot3((double)p02.a[0], q0, (double)p02.a[1], q1, (double)p02.a[2], q2) * det
    double nn = dot3(n0, n0, n1, n1, n2, n2)
    dist = (uint)(v * v).fusedMultiplyAdd(nn, 0.5)
    return true
}

void limitOrderedDitherPlan(ref List<byte> plan, nint at, int nplan, int nc0, Kcolor want, read Kd3Tree kd3) {
    int nc = nc0
    if nc > 16 {
        nc = 16
    }
    var cp = List<OdselectPlanitem>.repeat(OdselectPlanitem { plan = 0, frac = 0 }, 256)
    var bestcp = List<OdselectPlanitem>.repeat(OdselectPlanitem { plan = 0, frac = 0 }, 16)
    int nbestcp = 0

    // sort colors
    cp[0].plan = plan[at]
    cp[0].frac = 1
    nint ncp = 1
    for i in 1..(nint)nplan {
        if plan[at + i - 1] == plan[at + i] {
            cp[ncp - 1].frac += 1
        } else {
            cp[ncp].plan = plan[at + i]
            cp[ncp].frac = 1
            ncp += 1
        }
    }

    // calculate plan
    uint mindist = 0xFFFFFFFF
    uint dist = 0
    double ta = 0.0
    double tb = 0.0
    for i in 0..ncp {
        // check for closest single color
        dist = kcDistance(kd3.ks[(nint)cp[i].plan], want)
        if dist < mindist {
            bestcp[0].plan = cp[i].plan
            bestcp[0].frac = KcWhole
            nbestcp = 1
            mindist = dist
        }

        nint j = i + 1
        while nc >= 2 && j < ncp {
            // check for closest blend of two colors
            if kcLineClosest(kd3.ks[(nint)cp[i].plan], kd3.ks[(nint)cp[j].plan], want, ref ta, ref dist) && dist < mindist {
                bestcp[0].plan = cp[i].plan
                bestcp[1].plan = cp[j].plan
                bestcp[1].frac = (int)((double)KcWhole * ta)
                bestcp[0].frac = KcWhole - bestcp[1].frac
                nbestcp = 2
                mindist = dist
            }

            nint k = j + 1
            while nc >= 3 && k < ncp {
                // check for closest blend of three colors
                if kcPlaneClosest(kd3.ks[(nint)cp[i].plan], kd3.ks[(nint)cp[j].plan], kd3.ks[(nint)cp[k].plan], want,
                        ref ta, ref tb, ref dist) && dist < mindist {
                    bestcp[0].plan = cp[i].plan
                    bestcp[1].plan = cp[j].plan
                    bestcp[1].frac = (int)((double)KcWhole * ta)
                    bestcp[2].plan = cp[k].plan
                    bestcp[2].frac = (int)((double)KcWhole * tb)
                    bestcp[0].frac = KcWhole - bestcp[1].frac - bestcp[2].frac
                    nbestcp = 3
                    mindist = dist
                }
                k += 1
            }
            j += 1
        }
    }

    planFromCplan(ref plan, at, nplan, read bestcp, nbestcp, KcWhole)
}

// sorts the plan by luminance, then by index (a total order: equal items are equal bytes, so any
// sort gives qsort's order)
void sortOrderedDitherPlan(ref List<byte> plan, nint at, int nplan, read List<int> lum) {
    for i in 1..(nint)nplan {
        byte p = plan[at + i]
        long key = ((long)lum[(nint)p] << 8) | (long)p
        nint j = i
        while j > 0 {
            byte q = plan[at + j - 1]
            long qkey = ((long)lum[(nint)q] << 8) | (long)q
            if qkey <= key {
                break
            }
            plan[at + j] = q
            j -= 1
        }
        plan[at + j] = p
    }
}

void setOrderedDitherPlan(ref Gt g, ref List<byte> plan, nint at, int nplan, int nc, ref Color gfc, ref Kd3Tree kd3,
        read List<int> lum) {
    var err = wkcZero()
    var want = kd3Makegfcg(read g.kc, read kd3, gfc)
    var cur = kcolor(0, 0, 0)

    for i in 0..(nint)nplan {
        for d in 0..3 {
            int v = (int)want.a[d] + err.a[d]
            cur.a[d] = (short)kcClampv(v)
        }
        uint dist = 0
        plan[at + i] = kd3ClosestTransformed(ref kd3, cur, ref dist).wrappingToByte()
        for d in 0..3 {
            err.a[d] += (int)want.a[d] - (int)kd3.ks[(nint)plan[at + i]].a[d]
        }
    }

    sortOrderedDitherPlan(ref plan, at, nplan, lum)

    if nc < nplan && plan[at] != plan[at + (nint)nplan - 1] {
        int ncp = 1
        for i in 1..(nint)nplan {
            if plan[at + i - 1] != plan[at + i] {
                ncp += 1
            }
        }
        if ncp > nc {
            limitOrderedDitherPlan(ref plan, at, nplan, nc, want, read kd3)
        }
    }

    gfc.haspixel = 1
}

void colormapImageOrdered(ref Gt g, read Image gfi, ref List<byte> allNewData, ref Colormap oldCm, ref Kd3Tree kd3,
        ref List<uint> histogram, read List<byte> matrix) {
    int mw = (int)matrix[0]
    int mh = (int)matrix[1]
    int nplan = (int)matrix[2]
    // plans are indexed by pixel value, which can exceed old_cm->ncol
    var plan = List<byte>.repeat(0, (nint)nplan * 256)
    nint width = (nint)gfi.width
    int transparent = gfi.transparent

    // Written with reference to Joel Ylilouma's versions.

    // Initialize colors
    for i in 0..256 {
        oldCm.col[i].haspixel = 0
    }

    // Initialize luminances, create luminance sorter
    var lum = List<int>.repeat(0, (nint)kd3.nitems)
    for i in 0..(nint)kd3.nitems {
        lum[i] = kcLuminance(kd3.ks[i])
    }

    // Do the image!
    bool pow2 = (mw & (mw - 1)) == 0 && (mh & (mh - 1)) == 0 && (nplan & (nplan - 1)) == 0
    int mws = 0
    int nplans = 0
    if pow2 {
        while (1 << mws) != mw {
            mws += 1
        }
        while (1 << nplans) != nplan {
            nplans += 1
        }
    }
    for y in 0..(nint)gfi.height {
        nint row = gfi.rows[y]
        nint newRow = y * width
        for x in 0..width {
            byte d = gfi.data[row + x]
            // the transparent color never gets adjusted
            if (int)d == transparent {
                continue
            }
            nint thisplan = 0
            nint i = 0
            if pow2 {
                thisplan = (nint)d << (nint)nplans
                if oldCm.col[(nint)d].haspixel == 0 {
                    var gfc = oldCm.col[(nint)d]
                    setOrderedDitherPlan(ref g, ref plan, thisplan, 1 << nplans, (int)matrix[3], ref gfc, ref kd3, read lum)
                    oldCm.col[(nint)d] = gfc
                }
                i = (nint)matrix[4 + ((x + (nint)gfi.left) & (nint)(mw - 1)) + (((y + (nint)gfi.top) & (nint)(mh - 1)) << (nint)mws)]
            } else {
                thisplan = (nint)nplan * (nint)d
                if oldCm.col[(nint)d].haspixel == 0 {
                    var gfc = oldCm.col[(nint)d]
                    setOrderedDitherPlan(ref g, ref plan, thisplan, nplan, (int)matrix[3], ref gfc, ref kd3, read lum)
                    oldCm.col[(nint)d] = gfc
                }
                i = (nint)matrix[4 + (x + (nint)gfi.left) % (nint)mw + ((y + (nint)gfi.top) % (nint)mh) * (nint)mw]
            }
            byte p = plan[thisplan + i]
            allNewData[newRow + x] = p
            histogram[(nint)p] += 1
        }
    }
}

void dither(ref Gt g, read Image gfi, ref List<byte> newData, ref Colormap oldCm, ref Kd3Tree kd3, ref List<uint> histogram,
        read OutputData od) {
    if od.ditherType == DitherDefault || od.ditherType == DitherFloydSteinberg {
        colormapImageFloydSteinberg(ref g, gfi, ref newData, ref oldCm, ref kd3, ref histogram)
    } else if od.ditherType == DitherOrdered || od.ditherType == DitherOrderedNew {
        colormapImageOrdered(ref g, gfi, ref newData, ref oldCm, ref kd3, ref histogram, read od.ditherData)
    } else if od.ditherType == DitherAtkinson {
        colormapImageAtkinson(ref g, gfi, ref newData, ref oldCm, ref kd3, ref histogram)
    } else {
        colormapImagePosterize(ref g, gfi, ref newData, ref oldCm, ref kd3, ref histogram)
    }
}

// Gives the image's transparent pixels a color of `newCm`; true means run the dither again.
bool tryAssignTransparency(ref Image gfi, read Colormap oldCm, ref List<byte> newData, ref Colormap newCm, ref int newNcol,
        ref Kd3Tree kd3, read List<uint> histogram) {
    int transparent = gfi.transparent
    int newTransparent = -1

    if transparent < 0 {
        return false
    }

    var transpValue = color(0, 0, 0)
    if transparent < oldCm.ncol {
        transpValue = oldCm.col[(nint)transparent]
    }

    // look for an unused pixel in the existing colormap; prefer the same color we had
    for i in 0..(nint)newNcol {
        if histogram[i] == 0 && colorEq(transpValue, newCm.col[i]) {
            newTransparent = (int)i
            break
        }
    }
    if newTransparent < 0 {
        for i in 0..(nint)newNcol {
            if histogram[i] == 0 {
                newTransparent = (int)i
                break
            }
        }
    }

    // try to expand the colormap
    if newTransparent < 0 && newNcol < 256 {
        newTransparent = newNcol
        // copy only the color: new_cm's `pixel` fields count uses
        newCm.col[(nint)newTransparent].red = transpValue.red
        newCm.col[(nint)newTransparent].green = transpValue.green
        newCm.col[(nint)newTransparent].blue = transpValue.blue
        newNcol += 1
    }

    if newTransparent < 0 {
        // not found: mark the least-frequently-used color as the new transparent color and
        // return true (meaning 'dither again')
        uint minUsed = 0xFFFFFFFF
        for i in 0..256 {
            if histogram[i] < minUsed {
                newTransparent = (int)i
                minUsed = histogram[i]
            }
        }
        // mark it as unusable
        kd3Disable(ref kd3, newTransparent)
        return true
    }

    nint width = (nint)gfi.width
    nint nd = 0
    for j in 0..(nint)gfi.height {
        nint row = gfi.rows[j]
        for i in 0..width {
            if (int)gfi.data[row + i] == transparent {
                newData[nd] = (byte)newTransparent
            }
            nd += 1
        }
    }

    gfi.transparent = newTransparent
    return false
}

Colormap blankColormap() {
    return Colormap { ncol = 0, capacity = 0, userFlags = 0, refcount = 0, col = List<Color>(), live = false }
}

void colormapStream(ref Gt g, nint gfs, nint newCmAt, ref OutputData od, bool allowShrink0) {
    bool allowShrink = allowShrink0
    var kd3 = kd3None()
    int origNcol = g.colormaps[newCmAt].ncol
    int newNcol = origNcol

    // new_col[j].pixel == number of pixels with color j in the new image.
    for j in 0..256 {
        g.colormaps[newCmAt].col[j].pixel = 0
    }

    // initialize kd3 tree
    bool newGray = true
    for j in 0..(nint)g.colormaps[newCmAt].ncol {
        var c = g.colormaps[newCmAt].col[j]
        if c.red != c.green || c.red != c.blue {
            newGray = false
            break
        }
    }
    int transform = Kd3Gamma
    if newGray {
        transform = Kd3Luminance
    } else if od.colormapGammaType == KcGammaOklab {
        transform = Kd3Oklab
    }
    kd3InitBuild(read g.kc, ref kd3, transform, read g.colormaps[newCmAt])

    for imagei in 0..g.streams[gfs].images.length() {
        nint gfi = g.streams[gfs].images[imagei]
        nint gfcm = g.images[gfi].local
        if gfcm == None {
            gfcm = g.streams[gfs].global
        }
        bool onlyCompressed = !g.images[gfi].hasImg

        if gfcm != None {
            // If there was an old colormap, change the image data
            var newData = List<byte>.repeat(0, (nint)g.images[gfi].width * (nint)g.images[gfi].height)
            var histogram = List<uint>.repeat(0, 256)
            unmarkColors(ref g, newCmAt)
            unmarkColors(ref g, gfcm)

            if onlyCompressed {
                _ = gifUncompressImage(ref g, gfs, gfi)
            }

            kd3EnableAll(ref kd3)
            // The image and the two colormaps are taken out of the program's state while the
            // image is mapped, and put back after.
            var image = g.images[gfi].replace(emptyImage())
            var oldCm = g.colormaps[gfcm].replace(blankColormap())
            var newCm = g.colormaps[newCmAt].replace(blankColormap())
            while true {
                for j in 0..256 {
                    histogram[j] = 0
                }
                dither(ref g, read image, ref newData, ref oldCm, ref kd3, ref histogram, read od)
                if !tryAssignTransparency(ref image, read oldCm, ref newData, ref newCm, ref newNcol, ref kd3, read histogram) {
                    break
                }
            }
            g.images[gfi] = image
            g.colormaps[gfcm] = oldCm
            g.colormaps[newCmAt] = newCm

            gifReleaseUncompressedImage(ref g, gfi)
            // version 1.28 bug fix: release any compressed version or it'll cause bad images
            gifReleaseCompressedImage(ref g, gfi)
            gifSetUncompressedImage(ref g, gfi, newData, false)

            // update count of used colors
            for j in 0..256 {
                g.colormaps[newCmAt].col[j].pixel = g.colormaps[newCmAt].col[j].pixel.wrappingAdd(histogram[j])
            }
            int transparent = g.images[gfi].transparent
            if transparent >= 0 {
                // we don't have data on the number of used colors for transparency so fudge it;
                // but always count it, so allow_shrink keeps it
                uint fudge = (uint)g.images[gfi].width * (uint)g.images[gfi].height / 8
                if fudge == 0 {
                    fudge = 1
                }
                nint t = (nint)transparent
                g.colormaps[newCmAt].col[t].pixel = g.colormaps[newCmAt].col[t].pixel.wrappingAdd(fudge)
            }
        } else {
            // Can't compress new_cm afterwards if we didn't actively change colors over
            allowShrink = false
        }

        if g.images[gfi].local != None {
            gifDeleteColormap(ref g, g.images[gfi].local)
            g.images[gfi].local = None
        }

        // 1.92: recompress *after* deleting the local colormap. The image now uses new_cm, so
        // compress against it (--careful sizes codes from the colormap).
        if gfcm != None && onlyCompressed {
            nint oldGlobal = g.streams[gfs].global
            int oldNcol = g.colormaps[newCmAt].ncol
            g.streams[gfs].global = newCmAt
            g.colormaps[newCmAt].ncol = newNcol
            var info = g.gifWriteInfo
            _ = gifFullCompressImage(ref g, gfs, gfi, read info)
            g.colormaps[newCmAt].ncol = oldNcol
            g.streams[gfs].global = oldGlobal
            gifReleaseUncompressedImage(ref g, gfi)
        }
    }

    // Set new_cm->ncol from new_ncol. We didn't update new_cm->ncol before so the closest-color
    // algorithms wouldn't see any new transparent colors. That way added transparent colors were
    // only used for transparency.
    g.colormaps[newCmAt].ncol = newNcol

    // change the background. I hate the background by now
    nint nimages = g.streams[gfs].images.length()
    nint global = g.streams[gfs].global
    int firstTransparent = -1
    if nimages > 0 {
        firstTransparent = g.images[g.streams[gfs].images[0]].transparent
    }
    if (nimages == 0 || firstTransparent < 0) && global != None && g.streams[gfs].background < g.colormaps[global].ncol {
        var c = g.colormaps[global].col[(nint)g.streams[gfs].background]
        int bg = kd3Closest8g(read g.kc, ref kd3, (int)c.red, (int)c.green, (int)c.blue)
        g.streams[gfs].background = bg
        g.colormaps[newCmAt].col[(nint)bg].pixel = g.colormaps[newCmAt].col[(nint)bg].pixel.wrappingAdd(1)
    } else if nimages > 0 && firstTransparent >= 0 {
        g.streams[gfs].background = firstTransparent
    } else {
        g.streams[gfs].background = 0
    }

    gifDeleteColormap(ref g, g.streams[gfs].global)
    kd3Cleanup(ref kd3)

    // We may have used only a subset of the colors in new_cm. We try to store only that subset,
    // just as if we'd piped the output of 'gifsicle --use-colormap=X' through 'gifsicle' another
    // time.
    nint copy = gifCopyColormap(ref g, newCmAt)
    g.streams[gfs].global = copy
    nint ncol = (nint)g.colormaps[newCmAt].ncol
    for j in 0..ncol {
        g.colormaps[copy].col[j].haspixel = 0
    }
    if allowShrink {
        // only bother to recompress if we'll get anything out of it
        allowShrink = false
        for j in 0..ncol - 1 {
            uint here = g.colormaps[newCmAt].col[j].pixel
            if here == 0 || here < g.colormaps[newCmAt].col[j + 1].pixel {
                allowShrink = true
                break
            }
        }
    }

    if allowShrink {
        var map = int[256](0)

        // Gif_CopyColormap copies the 'pixel' values as well
        for j in 0..ncol {
            g.colormaps[copy].col[j].haspixel = (byte)j
        }

        // sort based on popularity
        var perm = List<int>.repeat(0, ncol)
        var key = List<long>.repeat(0, ncol)
        for j in 0..ncol {
            perm[j] = (int)j
            key[j] = -(long)g.colormaps[copy].col[j].pixel
        }
        sortPerm(ref perm, 0, ncol, read key)
        var sorted = List<Color>.withCapacity(ncol)
        for j in 0..ncol {
            sorted.add(g.colormaps[copy].col[(nint)perm[j]])
        }
        for j in 0..ncol {
            g.colormaps[copy].col[j] = sorted[j]
        }

        // set up the map and reduce the number of colors
        for j in 0..ncol {
            map[(nint)g.colormaps[copy].col[j].haspixel] = (int)j
        }
        for j in 0..ncol {
            if g.colormaps[copy].col[j].pixel == 0 {
                g.colormaps[copy].ncol = (int)j
                break
            }
        }

        // map the image data, transparencies, and background
        if g.streams[gfs].background < g.colormaps[copy].ncol {
            g.streams[gfs].background = map[(nint)g.streams[gfs].background]
        }
        for imagei in 0..g.streams[gfs].images.length() {
            nint gfi = g.streams[gfs].images[imagei]
            bool onlyCompressed = !g.images[gfi].hasImg
            if onlyCompressed {
                _ = gifUncompressImage(ref g, gfs, gfi)
            }

            nint size = (nint)g.images[gfi].width * (nint)g.images[gfi].height
            if size > g.images[gfi].data.length() {
                size = g.images[gfi].data.length()
            }
            for p in 0..size {
                g.images[gfi].data[p] = (byte)map[(nint)g.images[gfi].data[p]]
            }
            if g.images[gfi].transparent >= 0 {
                g.images[gfi].transparent = map[(nint)g.images[gfi].transparent]
            }

            if onlyCompressed {
                var info = g.gifWriteInfo
                _ = gifFullCompressImage(ref g, gfs, gfi, read info)
                gifReleaseUncompressedImage(ref g, gfi)
            }
        }
    }

    // new_cm may be shared with later outputs (--use-colormap), so remove any transparent colors
    // added to it
    g.colormaps[newCmAt].ncol = origNcol
}

// ---- Halftone algorithms ----

