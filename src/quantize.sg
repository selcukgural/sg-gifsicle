const byte[] DitherMatrixDiagonal45x8 = {
    8, 8, 64, 2,
    16, 32, 48, 56, 40, 24,  8,  0,
    36, 52, 60, 44, 28, 12,  4, 20,
    49, 57, 41, 25,  9,  1, 17, 33,
    61, 45, 29, 13,  5, 21, 37, 53,
    42, 26, 10,  2, 18, 34, 50, 58,
    30, 14,  6, 22, 38, 54, 62, 46,
    11,  3, 19, 35, 51, 59, 43, 27,
     7, 23, 39, 55, 63, 47, 31, 15
}

// ---- matrices made for a size: halftones ----

struct HalftonePixel : Copyable {
    int x
    int y
    double distance
    double angle
}

List<HalftonePixel> halftonePixelMake(int w, int h) {
    var hp = List<HalftonePixel>.withCapacity((nint)w * (nint)h)
    for y in 0..h {
        for x in 0..w {
            hp.add(HalftonePixel { x = x, y = y, distance = -1.0, angle = 0.0 })
        }
    }
    return hp
}

void halftonePixelCombine(ref HalftonePixel hp, double cx, double cy) {
    double dx = (double)hp.x - cx
    double dy = (double)hp.y - cy
    double d = dx.fusedMultiplyAdd(dx, dy * dy)
    if hp.distance < 0.0 || d < hp.distance {
        hp.distance = d
        hp.angle = dy.atan2(dx)
    }
}

// a key of a double whose order as a long is the order of the doubles; -0 is 0
long doubleOrderKey(double x) {
    double v = x + 0.0
    ulong bits = v.toBits()
    if v >= 0.0 {
        return (long)bits
    }
    return -(long)(bits & 0x7FFFFFFFFFFFFFFF) - 1
}

// Sorts the pixels as C's qsort does with gifsicle's `halftone_pixel_compare`: by distance, and by
// angle where the distances are within 0.01 (they are then equal: every distance is a multiple of
// 0.25), and never finding two pixels equal.
void sortHalftonePixels(ref List<HalftonePixel> hp) {
    nint n = hp.length()
    // the angles' ranks
    var perm = List<int>.repeat(0, n)
    var key = List<long>.repeat(0, n)
    for i in 0..n {
        perm[i] = (int)i
        key[i] = doubleOrderKey(hp[i].angle)
    }
    sortPerm(ref perm, 0, n, read key)
    var rank = List<long>.repeat(0, n)
    long r = 0
    for i in 0..n {
        if i > 0 && key[(nint)perm[i]] != key[(nint)perm[i - 1]] {
            r += 1
        }
        rank[(nint)perm[i]] = r
    }
    for i in 0..n {
        perm[i] = (int)i
        key[i] = ((long)(hp[i].distance * 4.0) << 20) | rank[i]
    }
    sortPermNoTies(ref perm, 0, n, read key)
    var sorted = List<HalftonePixel>.withCapacity(n)
    for i in 0..n {
        sorted.add(hp[(nint)perm[i]])
    }
    hp = sorted
}

List<byte> halftonePixelMatrix(read List<HalftonePixel> hp, int w, int h, int nc) {
    nint wh = (nint)w * (nint)h
    var m = List<byte>.repeat(0, 4 + wh)
    m[0] = (byte)w
    m[1] = (byte)h
    m[3] = (byte)nc
    if wh > 255 {
        double s = 255.0 / (double)wh
        m[2] = 255
        for i in 0..wh {
            m[4 + (nint)hp[i].x + (nint)hp[i].y * (nint)w] = (byte)(int)((double)i * s)
        }
    } else {
        m[2] = (byte)wh
        for i in 0..wh {
            m[4 + (nint)hp[i].x + (nint)hp[i].y * (nint)w] = (byte)i
        }
    }
    return m
}

List<byte> makeHalftoneMatrixSquare(int w, int h, int nc) {
    var hp = halftonePixelMake(w, h)
    for i in 0..hp.length() {
        halftonePixelCombine(ref hp[i], (double)(w - 1) / 2.0, (double)(h - 1) / 2.0)
    }
    sortHalftonePixels(ref hp)
    return halftonePixelMatrix(read hp, w, h, nc)
}

List<byte> makeHalftoneMatrixTriangular(int w, int h, int nc) {
    var hp = halftonePixelMake(w, h)
    double fw = (double)w
    double fh = (double)h
    for i in 0..hp.length() {
        halftonePixelCombine(ref hp[i], (fw - 1.0) / 2.0, (fh - 1.0) / 2.0)
        halftonePixelCombine(ref hp[i], -0.5, -0.5)
        halftonePixelCombine(ref hp[i], fw - 0.5, -0.5)
        halftonePixelCombine(ref hp[i], -0.5, fh - 0.5)
        halftonePixelCombine(ref hp[i], fw - 0.5, fh - 0.5)
    }
    sortHalftonePixels(ref hp)
    return halftonePixelMatrix(read hp, w, h, nc)
}

// ---- --dither ----

void ditherRelease(ref OutputData od) {
    od.ditherType = DitherNone
    od.ditherData.clear()
}

void copyDither(ref OutputData dst, read OutputData src) {
    dst.ditherType = src.ditherType
    dst.ditherData = src.ditherData.clone()
    dst.ditherName = src.ditherName.clone()
}

void setDitherMatrix(ref OutputData od, read byte[] matrix) {
    od.ditherType = DitherOrdered
    od.ditherData.clear()
    od.ditherData.addAll(matrix)
}

// Sets the dither of `od` from a name such as `o4` or `halftone,10,3`; -1 if it is not one.
int setDitherType(ref OutputData od, read string fullName) {
    var s = fullName.asBytes()
    nint len = s.length()
    var parm = int[4](0)
    int nparm = 0

    // separate arguments from dither name
    nint comma = -1
    var at = s.indexOf(0x2C)
    if at is not null {
        comma = at
    }
    nint nameEnd = len
    if comma >= 0 && comma < 256 {
        nameEnd = comma
    }
    var name = s[0..nameEnd]
    // C's strtol from the character after each separator, while that is a digit
    while nparm < 4 && comma >= 0 && comma < len && comma + 1 < len && isDigitByte(s[comma + 1]) {
        nint q = comma + 1
        long v = 0
        while q < len && isDigitByte(s[q]) {
            if v <= 65535 {
                v = v * 10 + (long)(s[q] - 0x30)
            }
            q += 1
        }
        if v > 65535 {
            v = 65535
        }
        parm[(nint)nparm] = (int)v
        comma = q
        nparm += 1
    }
    if comma >= 0 && comma < len {
        return -1
    }
    // matrices store the number of colors in a byte
    if nparm >= 2 && parm[1] > 255 {
        return -1
    }

    // parse dither name
    ditherRelease(ref od)

    if name == "none".asBytes() || name == "posterize".asBytes() {
        // ok
    } else if name == "default".asBytes() {
        od.ditherType = DitherDefault
    } else if name == "floyd-steinberg".asBytes() || name == "fs".asBytes() {
        od.ditherType = DitherFloydSteinberg
    } else if name == "atkinson".asBytes() || name == "at".asBytes() {
        od.ditherType = DitherAtkinson
    } else if name == "o3".asBytes() || name == "o3x3".asBytes() || (name == "o".asBytes() && nparm >= 1 && parm[0] == 3) {
        setDitherMatrix(ref od, read DitherMatrixO3x3)
    } else if name == "o4".asBytes() || name == "o4x4".asBytes() || (name == "o".asBytes() && nparm >= 1 && parm[0] == 4) {
        setDitherMatrix(ref od, read DitherMatrixO4x4)
    } else if name == "o8".asBytes() || name == "o8x8".asBytes() || (name == "o".asBytes() && nparm >= 1 && parm[0] == 8) {
        setDitherMatrix(ref od, read DitherMatrixO8x8)
    } else if name == "ro64".asBytes() || name == "ro64x64".asBytes() || name == "o".asBytes() || name == "ordered".asBytes() {
        setDitherMatrix(ref od, read DitherMatrixRo64x64)
    } else if name == "diag45".asBytes() || name == "diagonal".asBytes() {
        setDitherMatrix(ref od, read DitherMatrixDiagonal45x8)
    } else if name == "halftone".asBytes() || name == "half".asBytes() || name == "trihalftone".asBytes() || name == "trihalf".asBytes() {
        int size = 6
        if nparm >= 1 && parm[0] > 0 {
            size = parm[0]
        }
        int ncol = 2
        if nparm >= 2 && parm[1] > 1 {
            ncol = parm[1]
        }
        // matrix height (size * sqrt(3)) must fit in 255
        if size > 147 {
            return -1
        }
        od.ditherType = DitherOrderedNew
        int height = (int)((double)size).fusedMultiplyAdd(3.0.sqrt(), 0.5)
        od.ditherData = makeHalftoneMatrixTriangular(size, height, ncol)
    } else if name == "sqhalftone".asBytes() || name == "sqhalf".asBytes() || name == "squarehalftone".asBytes() {
        int size = 6
        if nparm >= 1 && parm[0] > 0 {
            size = parm[0]
        }
        int ncol = 2
        if nparm >= 2 && parm[1] > 1 {
            ncol = parm[1]
        }
        if size > 255 {
            return -1
        }
        od.ditherType = DitherOrderedNew
        od.ditherData = makeHalftoneMatrixSquare(size, size, ncol)
    } else {
        return -1
    }

    if od.ditherType == DitherOrdered && nparm >= 2 && parm[1] > 1 && parm[1] != (int)od.ditherData[3] {
        od.ditherData[3] = (byte)parm[1]
        od.ditherType = DitherOrderedNew
    }
    return 0
}
