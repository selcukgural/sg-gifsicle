// Copyright (C) 1997-2025 Eddie Kohler, ekohler@gmail.com
// SG translation of gifsicle 1.99. This file is part of sg-gifsicle.
//
// The GIF library is free software. It is distributed under the GNU General Public License,
// version 2; you can copy, distribute, or alter it at will, as long as this notice is kept intact
// and this source code is made available. There is no warranty, express or implied.
//
// The LZW encoder keeps its codes in an adaptive tree, after Whirlgif: each code is a node, whose
// children are a linked list until it has `MaxLinksType` of them and a table indexed by suffix after.
// The nodes are items of lists and point at each other by their place in them, where C uses
// pointers; a table is a stretch of the list `links`.
//
// The writer writes into memory; the file is written from it at the end.

const nint NodesSize = 4096
const nint LinksSize = 4096 + 256
const byte TableType = 0
const byte LinksTypeStart = 1
const byte MaxLinksType = 5

struct CodeTable {
    // the nodes: code, type, suffix, length, sibling and child (a node, or the start of a table
    // in `links`); -1 is the null pointer
    List<ushort> code
    List<byte> type
    List<byte> suffix
    List<uint> length
    List<int> sibling
    List<int> child
    // the lossy encoder's: the loss accumulated, and the error carried to the next pixel
    List<ulong> diffaccum
    List<Wkcolor> error

    List<int> links
    int clearCode
    uint maxLoss
    uint maxpos
    int linksPos

    bool hasGlobalKcs
    List<Kcolor> globalKcs
    bool hasLocalKcs
    List<Kcolor> localKcs
    // which of the two `kcs` is: 0 none, 1 global, 2 local
    int kcsWhich
    double lossScale
    bool hasKcdiff
    List<uint> kcdiff
}

struct Writer {
    List<byte> v
    CompressInfo gcinfo
    int globalSize
    int localSize
    bool errors
    bool cleared
    CodeTable codeTable
}

CodeTable newCodeTable(read CompressInfo gcinfo, read Kc kc) {
    var gfc = CodeTable {
        code = List<ushort>.repeat(0, NodesSize), type = List<byte>.repeat(0, NodesSize),
        suffix = List<byte>.repeat(0, NodesSize), length = List<uint>.repeat(0, NodesSize),
        sibling = List<int>.repeat(-1, NodesSize), child = List<int>.repeat(-1, NodesSize),
        diffaccum = List<ulong>(), error = List<Wkcolor>(),
        links = List<int>.repeat(-1, LinksSize), clearCode = 0, maxLoss = 0, maxpos = 0, linksPos = 0,
        hasGlobalKcs = false, globalKcs = List<Kcolor>(), hasLocalKcs = false, localKcs = List<Kcolor>(),
        kcsWhich = 0, lossScale = 0.0, hasKcdiff = false, kcdiff = List<uint>(),
    }
    if gcinfo.loss > 0 {
        gfc.maxLoss = (uint)gcinfo.loss * kcDistance(kcMake8g(kc, 0, 0, 0), kcMake8g(kc, 0, 0, 8))
    }
    if gfc.maxLoss > 0 {
        gfc.lossScale = 4.0 / (double)gfc.maxLoss
        gfc.diffaccum = List<ulong>.repeat(0, NodesSize)
        gfc.error = List<Wkcolor>.repeat(wkcZero(), NodesSize)
    }
    return gfc
}

Writer newWriter(read Kc kc, read CompressInfo? gcinfo) {
    var info = newCompressInfo()
    if gcinfo is not null {
        info = gcinfo
    }
    return Writer {
        v = List<byte>(), gcinfo = info, globalSize = 0, localSize = 0, errors = false, cleared = false,
        codeTable = newCodeTable(read info, kc),
    }
}

void gifPutByte(ref Writer grr, int b) {
    grr.v.add((byte)(b & 0xFF))
}

void gifPutUnsigned(ref Writer grr, int uns) {
    grr.v.add((byte)(uns & 0xFF))
    grr.v.add((byte)((uns >> 8) & 0xFF))
}

void gfcClear(ref CodeTable gfc) {
    // The first clear_code nodes are reserved for single-pixel codes
    gfc.linksPos = gfc.clearCode
    for c in 0..(nint)gfc.clearCode {
        gfc.code[c] = (ushort)c
        gfc.type[c] = LinksTypeStart
        gfc.suffix[c] = (byte)c
        gfc.length[c] = 1
        gfc.child[c] = -1
        gfc.links[c] = (int)c
    }
}

int gfcLookup(read CodeTable gfc, int node, byte suffix) {
    if node < 0 {
        return gfc.links[(nint)suffix]
    }
    nint n = (nint)node
    if gfc.type[n] == TableType {
        return gfc.links[(nint)gfc.child[n] + (nint)suffix]
    }
    int ch = gfc.child[n]
    while ch >= 0 {
        if gfc.suffix[(nint)ch] == suffix {
            return ch
        }
        ch = gfc.sibling[(nint)ch]
    }
    return -1
}

void gfcChangeNodeToTable(ref CodeTable gfc, int workNode, int nextNode) {
    // change links node to table node
    nint table = (nint)gfc.linksPos
    gfc.linksPos += gfc.clearCode
    for c in 0..(nint)gfc.clearCode {
        gfc.links[table + c] = -1
    }
    gfc.links[table + (nint)gfc.suffix[(nint)nextNode]] = nextNode
    int n = gfc.child[(nint)workNode]
    while n >= 0 {
        gfc.links[table + (nint)gfc.suffix[(nint)n]] = n
        n = gfc.sibling[(nint)n]
    }
    gfc.type[(nint)workNode] = TableType
    gfc.child[(nint)workNode] = (int)table
}

void gfcDefine(ref CodeTable gfc, int workNode, byte suffix, int nextCode) {
    // Add a new code to the dictionary; its node is LINKS_TYPE at first.
    nint next = (nint)nextCode
    nint work = (nint)workNode
    gfc.code[next] = (ushort)nextCode
    gfc.type[next] = LinksTypeStart
    gfc.suffix[next] = suffix
    gfc.length[next] = gfc.length[work] + 1
    gfc.child[next] = -1
    // link the new node into the work node's children
    if gfc.type[work] == TableType {
        gfc.links[(nint)gfc.child[work] + (nint)suffix] = nextCode
    } else if gfc.type[work] < MaxLinksType || gfc.linksPos + gfc.clearCode > (int)LinksSize {
        gfc.sibling[next] = gfc.child[work]
        gfc.child[work] = nextCode
        if gfc.type[work] < MaxLinksType {
            gfc.type[work] += 1
        }
    } else {
        gfcChangeNodeToTable(ref gfc, workNode, nextCode)
    }
}

// The place in the image's data of the pixel at `pos`, counting rows in the order they are written.
nint gifImageline(read Image gfi, uint pos) {
    uint width = (uint)gfi.width
    if width == 0 {
        return -1
    }
    uint y = pos / width
    uint x = pos - y * width
    if y == (uint)gfi.height {
        return -1
    }
    if gfi.interlace == 0 {
        return gfi.rows[(nint)y] + (nint)x
    }
    return gfi.rows[(nint)gifInterlaceLine((int)y, (int)gfi.height)] + (nint)x
}

uint gifLineEndpos(read Image gfi, uint pos) {
    uint y = pos / (uint)gfi.width
    return (y + 1) * (uint)gfi.width
}

byte gfcPixel(read CodeTable gfc, read Image gfi, uint pos) {
    uint y = pos / (uint)gfi.width
    uint x = pos - y * (uint)gfi.width
    if gfi.interlace != 0 {
        y = (uint)gifInterlaceLine((int)y, (int)gfi.height)
    }
    byte p = gfi.data[gfi.rows[(nint)y] + (nint)x]
    if (int)p >= gfc.clearCode {
        // should not happen unless GIF_WRITE_CAREFUL_MIN_CODE_BITS
        p = 0
    }
    return p
}

const uint RunEwmaShift = 4
const uint RunEwmaScale = 19
const uint RunInvThresh = 174

void writeCompressedData(ref Gt g, nint gfs, nint gfi, int minCodeBits, ref Writer grr) {
    // The image is taken out of the program's state while it is written, and put back after.
    var image = g.images[gfi].replace(emptyImage())
    writeCompressedImage(ref g, gfs, read image, minCodeBits, ref grr)
    g.images[gfi] = image
}

void writeCompressedImage(ref Gt g, nint gfs, read Image gfi, int minCodeBits, ref Writer grr) {
    var buf = List<byte>.repeat(0, 512 - 24)
    uint bufpos = 0
    uint bufcap = (uint)(512 - 24) * 8

    uint pos = 0
    uint clearBufpos = 0
    uint clearPos = 0
    uint imageEndpos = (uint)gfi.height * (uint)gfi.width

    nint imageline = -1
    uint lineEndpos = 0

    uint runEwma = 0
    int nextCode = 0
    int outputCode = 0

    int curCodeBits = minCodeBits + 1

    gifPutByte(ref grr, minCodeBits)
    grr.codeTable.clearCode = 1 << minCodeBits
    grr.codeTable.maxpos = (uint)gfi.width * (uint)gfi.height
    grr.cleared = false
    if grr.codeTable.maxLoss > 0 {
        gfcLossyInit(ref g, ref grr.codeTable, gfs, read gfi)
    }

    outputCode = grr.codeTable.clearCode

    while true {
        int workNode = -1
        byte suffix = 0
        uint run = 0

        // Output 'output_code' to the memory buffer.
        if bufpos + 32 >= bufcap {
            uint ncap = bufcap * 2 + (24 << 3)
            while buf.length() < (nint)(ncap >> 3) {
                buf.add(0)
            }
            bufcap = ncap
        }
        uint endpos = bufpos + (uint)curCodeBits
        while true {
            if (bufpos & 7) != 0 {
                buf[(nint)(bufpos >> 3)] |= (byte)(((uint)outputCode << (bufpos & 7)) & 0xFF)
            } else if (bufpos & 0x7FF) != 0 {
                buf[(nint)(bufpos >> 3)] = (byte)(((uint)outputCode >> (bufpos + (uint)curCodeBits - endpos)) & 0xFF)
            } else {
                buf[(nint)(bufpos >> 3)] = 255
                endpos += 8
            }
            bufpos += 8 - (bufpos & 7)
            if bufpos >= endpos {
                break
            }
        }
        bufpos = endpos

        // Handle special codes.
        if outputCode == grr.codeTable.clearCode {
            // Clear data and prepare gfc
            curCodeBits = minCodeBits + 1
            nextCode = grr.codeTable.clearCode + 2
            runEwma = (uint)1 << RunEwmaScale
            gfcClear(ref grr.codeTable)
            clearPos = 0
            clearBufpos = 0
            if grr.codeTable.maxLoss == 0 {
                imageline = gifImageline(read gfi, pos)
                lineEndpos = gifLineEndpos(read gfi, pos)
            }
        } else if outputCode == grr.codeTable.clearCode + 1 {
            break
        } else {
            if nextCode > (1 << curCodeBits) && curCodeBits < GifMaxCodeBits {
                // bump up compression size
                curCodeBits += 1
            }
        }

        // Find the next code to output.
        if grr.codeTable.maxLoss > 0 {
            workNode = gfcLookupLossy(ref grr.codeTable, read gfi, pos)
            if workNode >= 0 {
                run = grr.codeTable.length[(nint)workNode]
            } else {
                run = 0
            }
            pos += run
            if pos < imageEndpos && nextCode < GifMaxCode {
                suffix = gfcPixel(read grr.codeTable, read gfi, pos)
            }
        } else {
            workNode = -1
            run = 0
            while pos < imageEndpos {
                if pos == lineEndpos {
                    imageline = gifImageline(read gfi, pos)
                    lineEndpos += (uint)gfi.width
                }
                suffix = gfi.data[imageline]
                if (int)suffix >= grr.codeTable.clearCode {
                    // should not happen unless GIF_WRITE_CAREFUL_MIN_CODE_BITS
                    suffix = 0
                }
                int nextNode = gfcLookup(read grr.codeTable, workNode, suffix)
                if nextNode < 0 {
                    break
                }
                workNode = nextNode
                imageline += 1
                pos += 1
                run += 1
            }
        }

        if pos < imageEndpos {
            // Define the next code.
            if nextCode < GifMaxCode {
                gfcDefine(ref grr.codeTable, workNode, suffix, nextCode)
                nextCode += 1
            } else {
                // to match "> CUR_BUMP_CODE" above
                nextCode = GifMaxCode + 1
            }

            // Check whether to clear table.
            if nextCode > 4094 {
                bool doClear = (grr.gcinfo.flags & GifWriteEagerClear) != 0
                if !doClear {
                    uint pixelsLeft = imageEndpos - pos - 1
                    if pixelsLeft != 0 {
                        // Always clear if run_ewma gets small relative to min_code_bits. Otherwise,
                        // clear if #images/run is smaller than an empirical threshold, meaning it
                        // will take more than 3000 or so average runs to complete the image.
                        if runEwma < ((36 << RunEwmaScale) / (uint)minCodeBits) ||
                            pixelsLeft > uint.MaxValue / RunInvThresh ||
                            runEwma < pixelsLeft * RunInvThresh {
                            doClear = true
                        }
                    }
                }
                if (doClear || run < 7) && clearPos == 0 {
                    clearPos = pos - run
                    clearBufpos = bufpos
                } else if !doClear && run > 50 {
                    clearPos = 0
                    clearBufpos = 0
                }
                if doClear {
                    outputCode = grr.codeTable.clearCode
                    pos = clearPos
                    bufpos = clearBufpos
                    buf[(nint)(bufpos >> 3)] &= (byte)(((1 << (bufpos & 7)) - 1) & 0xFF)
                    grr.cleared = true
                    continue
                }
            }
        }

        if workNode >= 0 {
            outputCode = (int)grr.codeTable.code[(nint)workNode]
            // Adjust current run length average.
            run = (run << RunEwmaScale) + ((uint)1 << (RunEwmaShift - 1))
            if run < runEwma {
                runEwma -= (runEwma - run) >> RunEwmaShift
            } else {
                runEwma += (run - runEwma) >> RunEwmaShift
            }
        } else {
            outputCode = grr.codeTable.clearCode + 1
            // The decoder defines one last table entry after the last data code. If that entry
            // reaches a code-width boundary, EOI must use the wider size.
            if nextCode == (1 << curCodeBits) && curCodeBits < GifMaxCodeBits {
                curCodeBits += 1
            }
        }
    }

    // Output memory buffer to stream.
    bufpos = (bufpos + 7) >> 3
    buf[(nint)((bufpos - 1) & 0xFFFFFF00)] = (byte)((bufpos - 1) & 0xFF)
    buf[(nint)bufpos] = 0
    grr.v.addAll(buf[0..(nint)bufpos + 1])
}

int calculateMinCodeBits(read Gt g, nint gfi, read Writer grr) {
    int colorsUsed = -1
    if (grr.gcinfo.flags & GifWriteCarefulMinCodeSize) != 0 {
        // calculate m_c_b based on colormap
        if grr.localSize > 0 {
            colorsUsed = grr.localSize
        } else if grr.globalSize > 0 {
            colorsUsed = grr.globalSize
        }
    } else if g.images[gfi].hasImg {
        // calculate m_c_b from uncompressed data
        nint width = (nint)g.images[gfi].width
        nint height = (nint)g.images[gfi].height
        colorsUsed = 0
        nint y = 0
        while y < height && colorsUsed < 128 {
            nint at = g.images[gfi].rows[y]
            for x in at..at + width {
                int p = (int)g.images[gfi].data[x]
                if p > colorsUsed {
                    colorsUsed = p
                }
            }
            y += 1
        }
        colorsUsed += 1
    } else if g.images[gfi].hasCompressed {
        // take m_c_b from compressed image
        colorsUsed = 1 << (int)g.images[gfi].compressed[0]
    } else {
        // should never happen
        colorsUsed = 256
    }
    int minCodeBits = 2
    int i = 4
    while i < colorsUsed {
        minCodeBits += 1
        i *= 2
    }
    return minCodeBits
}

void saveCompressionResult(ref Gt g, nint gfi, ref Writer grr, bool ok) {
    if (grr.gcinfo.flags & GifWriteShrink) == 0 ||
        (ok && (!g.images[gfi].hasCompressed || (nint)g.images[gfi].compressed.length() > grr.v.length())) {
        if ok {
            g.images[gfi].compressed = grr.v.replace(List<byte>())
            g.images[gfi].hasCompressed = true
            g.images[gfi].compressedErrors = 0
        } else {
            g.images[gfi].compressed = List<byte>()
            g.images[gfi].hasCompressed = false
        }
    }
    grr.v.clear()
}

bool gifFullCompressImage(ref Gt g, nint gfs, nint gfi, read CompressInfo? gcinfo) {
    var grr = newWriter(read g.kc, gcinfo)
    grr.globalSize = getColorTableSize(read g, gfs, None, read grr)
    grr.localSize = getColorTableSize(read g, gfs, gfi, read grr)
    int minCodeBits = calculateMinCodeBits(read g, gfi, read grr)
    writeCompressedData(ref g, gfs, gfi, minCodeBits, ref grr)
    saveCompressionResult(ref g, gfi, ref grr, true)
    if (grr.gcinfo.flags & (GifWriteOptimize | GifWriteEagerClear)) == GifWriteOptimize && grr.cleared {
        grr.gcinfo.flags |= GifWriteEagerClear | GifWriteShrink
        writeCompressedData(ref g, gfs, gfi, minCodeBits, ref grr)
        saveCompressionResult(ref g, gfi, ref grr, true)
    }
    return true
}

int getColorTableSize(read Gt g, nint gfs, nint gfi, read Writer grr) {
    nint gfcm = g.streams[gfs].global
    if gfi != None {
        gfcm = g.images[gfi].local
    }
    if gfcm == None || g.colormaps[gfcm].ncol <= 0 {
        return 0
    }
    int ncol = g.colormaps[gfcm].ncol
    // Possibly bump up 'ncol' based on 'transparent' values, if careful_min_code_bits
    if (grr.gcinfo.flags & GifWriteCarefulMinCodeSize) != 0 {
        if gfi != None && g.images[gfi].transparent >= ncol {
            ncol = g.images[gfi].transparent + 1
        } else if gfi == None {
            for h in read g.streams[gfs].images {
                if g.images[h].transparent >= ncol {
                    ncol = g.images[h].transparent + 1
                }
            }
        }
    }
    // Make sure the colormap is a power of two entries; GIF doesn't allow a colormap with 1 entry.
    if ncol > 256 {
        ncol = 256
    }
    int totalcol = 2
    while totalcol < ncol {
        totalcol *= 2
    }
    return totalcol
}

void writeColorTable(read Colormap gfcm, int totalcol, ref Writer grr) {
    nint i = 0
    nint ncol = (nint)gfcm.ncol
    nint total = (nint)totalcol
    while i < ncol && i < total {
        var c = gfcm.col[i]
        grr.v.add(c.red)
        grr.v.add(c.green)
        grr.v.add(c.blue)
        i += 1
    }
    // Pad out colormap with black.
    while i < total {
        grr.v.add(0)
        grr.v.add(0)
        grr.v.add(0)
        i += 1
    }
}

void writeImage(ref Gt g, nint gfs, nint gfi, ref Writer grr) {
    int packed = 0
    grr.localSize = getColorTableSize(read g, gfs, gfi, read grr)

    gifPutByte(ref grr, 0x2C)
    gifPutUnsigned(ref grr, (int)g.images[gfi].left)
    gifPutUnsigned(ref grr, (int)g.images[gfi].top)
    gifPutUnsigned(ref grr, (int)g.images[gfi].width)
    gifPutUnsigned(ref grr, (int)g.images[gfi].height)

    if grr.localSize > 0 {
        int size = 2
        packed |= 0x80
        while size < grr.localSize {
            size *= 2
            packed += 1
        }
    }
    if g.images[gfi].interlace != 0 {
        packed |= 0x40
    }
    gifPutByte(ref grr, packed)

    if grr.localSize > 0 {
        writeColorTable(read g.colormaps[g.images[gfi].local], grr.localSize, ref grr)
    }

    // calculate min_code_bits here (because calculation may involve recompression, if
    // GIF_WRITE_CAREFUL_MIN_CODE_SIZE is true)
    int minCodeBits = calculateMinCodeBits(read g, gfi, read grr)

    // use existing compressed data if it exists.
    if g.images[gfi].hasCompressed &&
        ((grr.gcinfo.flags & GifWriteCarefulMinCodeSize) == 0 || (int)g.images[gfi].compressed[0] == minCodeBits) {
        grr.v.addAll(read g.images[gfi].compressed)
    } else if !g.images[gfi].hasImg {
        _ = gifUncompressImage(ref g, gfs, gfi)
        writeCompressedData(ref g, gfs, gfi, minCodeBits, ref grr)
        gifReleaseUncompressedImage(ref g, gfi)
    } else {
        writeCompressedData(ref g, gfs, gfi, minCodeBits, ref grr)
    }
}

void writeLogicalScreenDescriptor(ref Gt g, nint gfs, ref Writer grr) {
    // high resolution colors
    int packed = 0x70
    grr.globalSize = getColorTableSize(read g, gfs, None, read grr)
    gifCalculateScreenSize(ref g, gfs, false)
    gifPutUnsigned(ref grr, (int)g.streams[gfs].screenWidth)
    gifPutUnsigned(ref grr, (int)g.streams[gfs].screenHeight)
    if grr.globalSize > 0 {
        int size = 2
        packed |= 0x80
        while size < grr.globalSize {
            size *= 2
            packed += 1
        }
    }
    gifPutByte(ref grr, packed)
    if g.streams[gfs].background < grr.globalSize {
        gifPutByte(ref grr, g.streams[gfs].background)
    } else {
        gifPutByte(ref grr, 255)
    }
    // no aspect ratio information
    gifPutByte(ref grr, 0)
    if grr.globalSize > 0 {
        writeColorTable(read g.colormaps[g.streams[gfs].global], grr.globalSize, ref grr)
    }
}

void writeGraphicControlExtension(read Image gfi, ref Writer grr) {
    int packed = 0
    gifPutByte(ref grr, 0x21)
    gifPutByte(ref grr, 0xF9)
    gifPutByte(ref grr, 4)
    if gfi.transparent >= 0 {
        packed |= 0x01
    }
    packed |= ((int)gfi.disposal & 0x07) << 2
    gifPutByte(ref grr, packed)
    gifPutUnsigned(ref grr, (int)gfi.delay)
    gifPutByte(ref grr, gfi.transparent)
    gifPutByte(ref grr, 0)
}

void writeNetscapeLoopExtension(int value, ref Writer grr) {
    grr.v.add(0x21)
    grr.v.add(0xFF)
    grr.v.add(0x0B)
    grr.v.addAll("NETSCAPE2.0".asBytes())
    grr.v.add(0x03)
    grr.v.add(0x01)
    gifPutUnsigned(ref grr, value)
    gifPutByte(ref grr, 0)
}

void writeGenericExtension(read Extension gfex, ref Writer grr) {
    // ignore our private extensions
    if gfex.kind < 0 {
        return
    }
    gifPutByte(ref grr, 0x21)
    gifPutByte(ref grr, gfex.kind)
    if gfex.kind == GifExApp {
        gifPutByte(ref grr, (int)GifExAppIdSize)
        grr.v.addAll(read gfex.appname)
    }
    nint length = gfex.data.length()
    if gfex.packetized {
        grr.v.addAll(read gfex.data)
    } else {
        nint pos = 0
        while pos + 255 < length {
            gifPutByte(ref grr, 255)
            grr.v.addAll(gfex.data[pos..pos + 255])
            pos += 255
        }
        if pos < length {
            gifPutByte(ref grr, (int)(length - pos))
            grr.v.addAll(gfex.data[pos..length])
        }
    }
    gifPutByte(ref grr, 0)
}

void writeGif(ref Gt g, nint gfs, ref Writer grr) {
    bool isgif89a = false
    if g.streams[gfs].endExtensions.length() > 0 || g.streams[gfs].loopcount > -1 {
        isgif89a = true
    }
    for gfi in read g.streams[gfs].images {
        if isgif89a {
            break
        }
        if g.images[gfi].transparent != -1 || g.images[gfi].disposal != 0 || g.images[gfi].delay != 0 ||
            g.images[gfi].extensions.length() > 0 {
            isgif89a = true
        }
    }
    if isgif89a {
        grr.v.addAll("GIF89a".asBytes())
    } else {
        grr.v.addAll("GIF87a".asBytes())
    }
    writeLogicalScreenDescriptor(ref g, gfs, ref grr)
    if g.streams[gfs].loopcount > -1 {
        writeNetscapeLoopExtension((int)(g.streams[gfs].loopcount & 0xFFFF), ref grr)
    }
    nint n = g.streams[gfs].images.length()
    for i in 0..n {
        gifIncrementalWriteImage(ref g, ref grr, gfs, g.streams[gfs].images[i])
    }
    for gfex in read g.streams[gfs].endExtensions {
        writeGenericExtension(gfex, ref grr)
    }
    gifPutByte(ref grr, 0x3B)
}

// The GIF's bytes, as gifsicle writes them to a file.
List<byte> gifFullWriteFile(ref Gt g, nint gfs, read CompressInfo? gcinfo) {
    var grr = newWriter(read g.kc, gcinfo)
    writeGif(ref g, gfs, ref grr)
    return grr.v.replace(List<byte>())
}

void gifIncrementalWriteImage(ref Gt g, ref Writer grr, nint gfs, nint gfi) {
    for gfex in read g.images[gfi].extensions {
        writeGenericExtension(gfex, ref grr)
    }
    if g.images[gfi].transparent != -1 || g.images[gfi].disposal != 0 || g.images[gfi].delay != 0 {
        writeGraphicControlExtension(read g.images[gfi], ref grr)
    }
    writeImage(ref g, gfs, gfi, ref grr)
}
