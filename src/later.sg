int setDitherType(ref OutputData od, read string name) {
    if name == "none" || name == "posterize" {
        od.ditherType = DitherNone
        od.ditherData.clear()
        return 0
    }
    if name == "default" {
        od.ditherType = DitherDefault
        od.ditherData.clear()
        return 0
    }
    return -1
}

void copyDither(ref OutputData dst, read OutputData src) {
    dst.ditherType = src.ditherType
    dst.ditherData = src.ditherData.clone()
    dst.ditherName = src.ditherName.clone()
}

void gfcLossyInit(ref Gt g, ref CodeTable gfc, nint gfs, read Image gfi) {
    gfc.maxLoss = 0
}

int gfcLookupLossy(ref CodeTable gfc, read Image gfi, uint pos) {
    return -1
}
