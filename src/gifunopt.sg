const ushort Transparent = 256

// The size of the part of gfi that's on the screen: frames can extend past the logical screen, or
// start beyond it.
void clipToScreen(read Stream gfs, read Image gfi, ref uint w, ref uint h) {
    if gfi.left < gfs.screenWidth {
        w = (uint)gfs.screenWidth - (uint)gfi.left
    } else {
        w = 0
    }
    if w > (uint)gfi.width {
        w = (uint)gfi.width
    }
    if gfi.top < gfs.screenHeight {
        h = (uint)gfs.screenHeight - (uint)gfi.top
    } else {
        h = 0
    }
    if h > (uint)gfi.height {
        h = (uint)gfi.height
    }
}

void putImageInScreen(read Stream gfs, read Image gfi, ref List<ushort> screen) {
    int transparent = gfi.transparent
    uint w = 0
    uint h = 0
    clipToScreen(gfs, gfi, ref w, ref h)
    nint sw = (nint)gfs.screenWidth
    for y in 0..(nint)h {
        nint move = sw * (y + (nint)gfi.top) + (nint)gfi.left
        nint line = gfi.rows[y]
        for x in 0..(nint)w {
            byte p = gfi.data[line + x]
            if (int)p != transparent {
                screen[move + x] = (ushort)p
            }
        }
    }
}

// Background disposal makes the frame's area transparent, as in browsers.
void putBackgroundInScreen(read Stream gfs, read Image gfi, ref List<ushort> screen) {
    uint w = 0
    uint h = 0
    clipToScreen(gfs, gfi, ref w, ref h)
    nint sw = (nint)gfs.screenWidth
    for y in 0..(nint)h {
        nint move = sw * (y + (nint)gfi.top) + (nint)gfi.left
        for x in 0..(nint)w {
            screen[move + x] = Transparent
        }
    }
}

// The first color unused in shown, or -1 if all 256 colors are used; whether shown has transparent
// pixels.
int firstUnusedColor(read List<ushort> shown, ref bool hasTransparent) {
    var have = List<bool>.repeat(false, 257)
    for p in read shown {
        have[(nint)p] = true
    }
    hasTransparent = have[256]
    for i in 0..256 {
        if !have[i] {
            return (int)i
        }
    }
    return -1
}

// Unoptimized image data for shown, mapping transparency to `transparent`.
List<byte> unoptimizedData(read List<ushort> shown, int transparent) {
    var newData = List<byte>.withCapacity(shown.length())
    for p in read shown {
        if p == Transparent {
            newData.add((byte)(transparent & 0xFF))
        } else {
            newData.add((byte)p)
        }
    }
    return newData
}

bool noMoreTransparency(read Image gfi1, read Image gfi2) {
    int t1 = gfi1.transparent
    int t2 = gfi2.transparent
    if t1 < 0 {
        return true
    }
    nint width = (nint)gfi1.width
    for y in 0..(nint)gfi1.height {
        nint d1 = gfi1.rows[y]
        nint d2 = gfi2.rows[y]
        for x in 0..width {
            if (int)gfi1.data[d1 + x] == t1 && (int)gfi2.data[d2 + x] != t2 {
                return false
            }
        }
    }
    return true
}

// Whether the unoptimized frames might use all 256 colors: they can only use the opaque colors in
// the frames.
bool mightRunOutOfColors(ref Gt g, nint gfs) {
    var have = List<bool>.repeat(false, 256)
    int ncolors = 0
    nint i = 0
    nint n = g.streams[gfs].images.length()
    while i < n && ncolors < 256 {
        nint gfi = g.streams[gfs].images[i]
        _ = gifUncompressImage(ref g, gfs, gfi)
        int transparent = g.images[gfi].transparent
        nint width = (nint)g.images[gfi].width
        for y in 0..(nint)g.images[gfi].height {
            nint row = g.images[gfi].rows[y]
            for x in 0..width {
                byte p = g.images[gfi].data[row + x]
                if !have[(nint)p] && (int)p != transparent {
                    have[(nint)p] = true
                    ncolors += 1
                }
            }
        }
        i += 1
    }
    return ncolors >= 256
}

// Make sure the global colormap has a slot for color index c.
void ensureGlobalColor(ref Gt g, nint gfs, int c) {
    nint gfcm = g.streams[gfs].global
    if c >= g.colormaps[gfcm].ncol {
        while g.colormaps[gfcm].col.length() < 256 {
            g.colormaps[gfcm].col.add(noColor())
        }
        if g.colormaps[gfcm].capacity < 256 {
            g.colormaps[gfcm].capacity = 256
        }
        while g.colormaps[gfcm].ncol <= c {
            nint k = (nint)g.colormaps[gfcm].ncol
            g.colormaps[gfcm].col[k].red = 0
            g.colormaps[gfcm].col[k].green = 0
            g.colormaps[gfcm].col[k].blue = 0
            g.colormaps[gfcm].ncol += 1
        }
    }
}

// Unoptimize every frame. If !commit, only check whether that's possible, without changing the
// stream.
bool unoptimizeFrames(ref Gt g, nint gfs, ref List<ushort> screen, bool commit) {
    int frame0Unused = -1
    bool frame0Transparent = false
    bool anyTransparent = false
    for pos in 0..screen.length() {
        screen[pos] = Transparent
    }
    nint n = g.streams[gfs].images.length()
    for i in 0..n {
        nint gfi = g.streams[gfs].images[i]
        _ = gifUncompressImage(ref g, gfs, gfi)
        int disposal = (int)g.images[gfi].disposal
        // For PREVIOUS disposal the frame is drawn on a copy, so that screen is unchanged after.
        bool previous = disposal == GifDisposalPrevious
        var shown = List<ushort>()
        if previous {
            shown = screen.clone()
            putImageInScreen(read g.streams[gfs], read g.images[gfi], ref shown)
        } else {
            putImageInScreen(read g.streams[gfs], read g.images[gfi], ref screen)
        }

        // transparency is represented by a color unused in the frame
        bool hasTransparent = false
        int unused = 0
        if previous {
            unused = firstUnusedColor(read shown, ref hasTransparent)
        } else {
            unused = firstUnusedColor(read screen, ref hasTransparent)
        }
        if i == 0 {
            frame0Unused = unused
            frame0Transparent = hasTransparent
        } else if hasTransparent {
            anyTransparent = true
        }
        if !hasTransparent {
            unused = -1
        } else if unused < 0 {
            if disposal == GifDisposalBackground {
                putBackgroundInScreen(read g.streams[gfs], read g.images[gfi], ref screen)
            }
            return false
        }

        var newData = List<byte>()
        if commit {
            if previous {
                newData = unoptimizedData(read shown, unused)
            } else {
                newData = unoptimizedData(read screen, unused)
            }
        }
        if disposal == GifDisposalBackground {
            putBackgroundInScreen(read g.streams[gfs], read g.images[gfi], ref screen)
        }

        if commit {
            if unused >= 0 {
                ensureGlobalColor(ref g, gfs, unused)
            }
            gifReleaseCompressedImage(ref g, gfi)
            g.images[gfi].left = 0
            g.images[gfi].top = 0
            g.images[gfi].width = g.streams[gfs].screenWidth
            g.images[gfi].height = g.streams[gfs].screenHeight
            g.images[gfi].transparent = unused
            if newData.length() == 0 {
                newData.add(0)
            }
            gifSetUncompressedImage(ref g, gfi, newData, false)
        }
    }

    // The background is transparent. If any frame shows the background, keep a transparent color
    // in the first frame, even if it is unused there, so older readers agree.
    if !frame0Transparent && anyTransparent {
        if frame0Unused < 0 {
            return false
        }
        if commit {
            ensureGlobalColor(ref g, gfs, frame0Unused)
            g.images[g.streams[gfs].images[0]].transparent = frame0Unused
        }
    }
    return true
}

bool gifFullUnoptimize(ref Gt g, nint gfs, int flags) {
    nint n = g.streams[gfs].images.length()
    if n < 1 {
        return true
    }
    for gfi in read g.streams[gfs].images {
        if g.images[gfi].local != None {
            return false
        }
    }
    if g.streams[gfs].global == None {
        return false
    }
    gifCalculateScreenSize(ref g, gfs, false)
    nint size = (nint)g.streams[gfs].screenWidth * (nint)g.streams[gfs].screenHeight
    var screen = List<ushort>.repeat(0, size)

    // Unoptimizing fails only if a frame needs a transparent color but uses all 256 colors. If
    // that's possible, check first, so failure leaves the stream unchanged.
    bool ok = true
    if mightRunOutOfColors(ref g, gfs) {
        ok = unoptimizeFrames(ref g, gfs, ref screen, false)
    }
    if ok {
        ok = unoptimizeFrames(ref g, gfs, ref screen, true)
    }
    if ok {
        if (flags & GifUnoptimizeSimplestDisposal) != 0 {
            // If every transparent pixel in frame i is also transparent in frame i - 1, then frame
            // i - 1 gets disposal ASIS; otherwise, disposal BACKGROUND.
            for i in 0..n {
                nint gfi = g.streams[gfs].images[i]
                if i == n - 1 || noMoreTransparency(read g.images[g.streams[gfs].images[i + 1]], read g.images[gfi]) {
                    g.images[gfi].disposal = (byte)GifDisposalNone
                } else {
                    g.images[gfi].disposal = (byte)GifDisposalBackground
                }
            }
        } else {
            for i in 0..n {
                g.images[g.streams[gfs].images[i]].disposal = (byte)GifDisposalBackground
            }
        }
    }
    return ok
}
