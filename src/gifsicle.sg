// frame option types
const int ChInterlace = 0
const int ChDisposal = 1
const int ChDelay = 2
const int ChTransparent = 3
const int ChComment = 4
const int ChName = 5
const int ChPosition = 6
const int ChCrop = 7
const int ChExtension = 8
const int ChFlip = 9
const int ChRotate = 10
string frameOptionType(int i) {
    return match i {
        0 => "interlace"
        1 => "disposal"
        2 => "delay"
        3 => "transparency"
        4 => "comment"
        5 => "name"
        6 => "position"
        7 => "crop"
        8 => "extension"
        9 => "flip"
        10 => "rotation"
        _ => ""
    }
}

// input option types
const int ChUnoptimize = 0
const int ChChangeColor = 1
string inputOptionType(int i) {
    return match i {
        0 => "unoptimization"
        1 => "color change"
        _ => ""
    }
}

// output option types
const int ChLoopcount = 0
const int ChLogicalScreen = 1
const int ChOptimize = 2
const int ChOutput = 3
const int ChColormap = 4
const int ChDither = 5
const int ChUseColormap = 6
const int ChColormapMethod = 7
const int ChBackground = 8
const int ChColorTransform = 9
const int ChResize = 10
const int ChMemory = 11
const int ChGamma = 12
const int ChResizeMethod = 13
const int ChScaleColors = 14
string outputOptionType(int i) {
    return match i {
        0 => "loopcount"
        1 => "logical screen"
        2 => "optimization"
        3 => "output file"
        4 => "colormap size"
        5 => "dither"
        6 => "colormap"
        7 => "colormap method"
        8 => "background"
        9 => "color transformation"
        10 => "resize"
        11 => "memory conservation"
        12 => "gamma"
        13 => "resize method"
        14 => "resize colors"
        _ => ""
    }
}

