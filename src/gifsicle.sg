    option(ref g, ref o, "resize-touc", 0, ResizeTouchOpt, DimensionsType, n)
    option(ref g, ref o, "resize-tou", 0, ResizeTouchOpt, DimensionsType, n)
    option(ref g, ref o, "resize-to", 0, ResizeTouchOpt, DimensionsType, n)
    option(ref g, ref o, "resize-t", 0, ResizeTouchOpt, DimensionsType, n)
    option(ref g, ref o, "resize-geometry", 0, ResizeGeometryOpt, ClpValString, n)
    option(ref g, ref o, "resize-method", 0, ResizeMethodOpt, ResizeMethodType, 0)
    option(ref g, ref o, "resize-colors", 0, ResizeColorsOpt, ClpValInt, n)
    option(ref g, ref o, "rotate-90", 0, Rotate90Opt, 0, 0)
    option(ref g, ref o, "rotate-180", 0, Rotate180Opt, 0, 0)
    option(ref g, ref o, "rotate-270", 0, Rotate270Opt, 0, 0)
    option(ref g, ref o, "no-rotate", 0, NoRotateOpt, 0, 0)
    option(ref g, ref o, "same-app-extensions", 0, SameAppExtensionsOpt, 0, 0)
    option(ref g, ref o, "same-background", 0, SameBackgroundOpt, 0, 0)
    option(ref g, ref o, "same-bg", 0, SameBackgroundOpt, 0, 0)
    option(ref g, ref o, "same-clip", 0, SameCropOpt, 0, 0)
    option(ref g, ref o, "same-comments", 0, SameCommentsOpt, 0, 0)
    option(ref g, ref o, "same-crop", 0, SameCropOpt, 0, 0)
    option(ref g, ref o, "same-extensions", 0, SameExtensionsOpt, 0, 0)
    option(ref g, ref o, "same-interlace", 0, SameInterlaceOpt, 0, 0)
    option(ref g, ref o, "same-logical-screen", 0, SameLogicalScreenOpt, 0, 0)
    option(ref g, ref o, "same-loopcount", 0, SameLoopcountOpt, 0, 0)
    option(ref g, ref o, "same-disposal", 0, SameDisposalOpt, 0, 0)
    option(ref g, ref o, "same-delay", 0, SameDelayOpt, 0, 0)
    option(ref g, ref o, "same-names", 0, SameNameOpt, 0, 0)
    option(ref g, ref o, "same-position", 0, SamePositionOpt, 0, 0)
    option(ref g, ref o, "same-screen", 0, SameLogicalScreenOpt, 0, 0)
    option(ref g, ref o, "same-transparent", 0, SameTransparentOpt, 0, 0)
    option(ref g, ref o, "scale", 0, ScaleOpt, ScaleFactorType, n)
    option(ref g, ref o, "scale-method", 0, ResizeMethodOpt, ResizeMethodType, 0)
    option(ref g, ref o, "scale-colors", 0, ResizeColorsOpt, ClpValInt, n)
    option(ref g, ref o, "screen", 0, LogicalScreenOpt, DimensionsType, n)
    option(ref g, ref o, "sinfo", 0, SizeInfoOpt, 0, n)
    option(ref g, ref o, "size-info", 0, SizeInfoOpt, 0, n)
    option(ref g, ref o, "transform-colormap", 0, ColorTransformOpt, ClpValStringNotOption, n)
    option(ref g, ref o, "transparent", 0x74, 0x74, ColorType, n)
    option(ref g, ref o, "unoptimize", 0x55, UnoptimizeOpt, 0, n)
    option(ref g, ref o, "use-colormap", 0, UseColormapOpt, ClpValString, n)
    option(ref g, ref o, "use-exact-colormap", 0, UseExactColormapOpt, ClpValString, n)
    option(ref g, ref o, "verbose", 0x56, VerboseOpt, 0, n)
    option(ref g, ref o, "", 0x76, VerboseOpt, 0, n)
    option(ref g, ref o, "version", 0, VersionOpt, 0, 0)
    option(ref g, ref o, "", 0x77, NoWarningsOpt, 0, n)
    option(ref g, ref o, "warnings", 0, WarningsOpt, 0, n)
    option(ref g, ref o, "xinfo", 0, ExtensionInfoOpt, 0, n)
    option(ref g, ref o, "threads", 0x6A, ThreadsOpt, ClpValUnsigned, ClpOptional | n)
    clpSetOptions(ref g.clp, o)

    clpAddStringListType(ref g.clp, LoopType, ClpAllowNumbers, read List<string> { "infinite", "forever" }, read List<long> { 0, 0 })
    clpAddStringListType(ref g.clp, DisposalType, ClpAllowNumbers,
        read List<string> { "none", "asis", "background", "bg", "previous" },
        read List<long> { (long)GifDisposalNone, (long)GifDisposalAsis, (long)GifDisposalBackground, (long)GifDisposalBackground, (long)GifDisposalPrevious })
    clpAddStringListType(ref g.clp, ColormapAlgType, 0,
        read List<string> { "diversity", "blend-diversity", "median-cut" },
        read List<long> { (long)ColormapDiversity, (long)ColormapBlendDiversity, (long)ColormapMedianCut })
    clpAddStringListType(ref g.clp, OptimizeType, ClpAllowNumbers,
        read List<string> { "keep-empty", "no-keep-empty", "drop-empty", "no-drop-empty" },
        read List<long> { (long)GtOptKeepempty + 1, (long)GtOptKeepempty, (long)GtOptKeepempty, (long)GtOptKeepempty + 1 })
    clpAddStringListType(ref g.clp, ResizeMethodType, 0,
        read List<string> { "point", "sample", "mix", "box", "catrom", "lanczos", "lanczos2", "lanczos3", "mitchell", "fast", "good" },
        read List<long> {
            (long)ScaleMethodPoint, (long)ScaleMethodPoint, (long)ScaleMethodMix, (long)ScaleMethodBox,
            (long)ScaleMethodCatrom, (long)ScaleMethodLanczos3, (long)ScaleMethodLanczos2,
            (long)ScaleMethodLanczos3, (long)ScaleMethodMitchell, (long)ScaleMethodPoint, (long)ScaleMethodMix,
        })
    clpAddType(ref g.clp, DimensionsType, 0, ParseUser, 0)
    clpAddType(ref g.clp, PositionType, 0, ParseUser, 0)
    clpAddType(ref g.clp, ScaleFactorType, 0, ParseUser, 0)
    clpAddType(ref g.clp, FrameSpecType, 0, ParseUser, 0)
    clpAddType(ref g.clp, ColorType, ClpDisallowOptions, ParseUser, 0)
    clpAddType(ref g.clp, RectangleType, 0, ParseUser, 0)
    clpAddType(ref g.clp, TwoColorsType, ClpDisallowOptions, ParseUser, 0)
    clpSetOptionChar(ref g.clp, 0x2B, ClpShortNegated)
}

// ---- main ----

void main(List<string> args) {
    var g = newGt(args)
    defineOptions(ref g)
    g.frames = newFrameset(ref g)
    initializeDefFrame(ref g)
    g.gifWriteInfo = newCompressInfo()
    g.defaultErrorHandler = HandlerGifsicle
    exit((byte)gifsicleMain(ref g))
}

int gifsicleMain(ref Gt g) {
    while true {
        if g.msgs.stopping {
            return 1
        }
        int opt = clpNext(ref g)
        bool badOption = false
        if opt == 0x62 {
            _ = setMode(ref g, Batching)
        } else if opt == 0x6D {
            _ = setMode(ref g, Merging)
        } else if opt == 0x65 {
            _ = setMode(ref g, Exploding)
            g.defFrame.explodeByName = false
        } else if opt == 0x45 {
            _ = setMode(ref g, Exploding)
            g.defFrame.explodeByName = true
        } else if opt == InfoOpt {
            if g.clp.negated {
                g.infoing = 0
            } else if g.infoing == 1 {
                // switch between infoing == 1 (suppress regular output) and 2 (don't suppress)
                g.infoing = 2
            } else {
                g.infoing = 1
            }
        } else if opt == ColorInfoOpt || opt == ExtensionInfoOpt || opt == SizeInfoOpt {
            int flag = InfoColormaps
            if opt == ExtensionInfoOpt {
                flag = InfoExtensions
            } else if opt == SizeInfoOpt {
                flag = InfoSizes
            }
            if g.clp.negated {
                g.defFrame.infoFlags &= ~flag
            } else {
                g.defFrame.infoFlags |= flag
                if g.infoing == 0 {
                    g.infoing = 1
                }
            }
        } else if opt == VerboseOpt {
            g.msgs.verbosing = !g.clp.negated
        } else if opt == DeleteOpt || opt == ReplaceOpt || opt == InsertOpt || opt == AppendOpt {
            frameChangeDone(ref g)
            setFrameChange(ref g, opt)
        } else if opt == AlterDoneOpt {
            frameChangeDone(ref g)
        } else if opt == NameOpt && !g.clp.negated {
            if changed(g.nextFrame, ChName) && gifExtensionListName(read g.defFrame.extensions) is not null {
                redundantOptionWarning(ref g, read frameOptionType(ChName))
            }
            g.nextFrame |= 1 << ChName
            var gfex = gifNewExtensionData(GifExName, "".asBytes(), g.clp.vstr.asBytes())
            deleteMatchingExtensions(ref g.defFrame.extensions, NoexfName)
            g.defFrame.extensions.add(gfex)
            g.defFrame.frameNoExtensionsFlag |= NoexfName
        } else if opt == NoNameOpt || opt == NameOpt {
            markFrame(ref g, ChName)
            g.defFrame.noExtensionsFlag |= NoexfName
            g.defFrame.frameNoExtensionsFlag &= ~NoexfName
            deleteMatchingExtensions(ref g.defFrame.extensions, NoexfName)
        } else if opt == SameNameOpt {
            g.defFrame.noExtensionsFlag &= ~NoexfName
            g.defFrame.frameNoExtensionsFlag &= ~NoexfName
            deleteMatchingExtensions(ref g.defFrame.extensions, NoexfName)
        } else if opt == CommentOpt && !g.clp.negated {
            markExtensionChange(ref g, NoexfComment)
            g.defFrame.extensions.add(gifNewExtensionData(GifExComment, "".asBytes(), g.clp.vstr.asBytes()))
        } else if opt == NoCommentsOpt || opt == CommentOpt {
            g.defFrame.noExtensionsFlag |= NoexfComment
            deleteMatchingExtensions(ref g.defFrame.extensions, NoexfComment)
        } else if opt == SameCommentsOpt {
            g.defFrame.noExtensionsFlag &= ~NoexfComment
        } else if opt == 0x69 {
            markFrame(ref g, ChInterlace)
            if g.clp.negated {
                g.defFrame.interlacing = 0
            } else {
                g.defFrame.interlacing = 1
            }
        } else if opt == SameInterlaceOpt {
            g.defFrame.interlacing = -1
        } else if opt == PositionOpt {
            markFrame(ref g, ChPosition)
            if g.clp.negated {
                g.defFrame.left = 0
                g.defFrame.top = 0
            } else {
                g.defFrame.left = g.clp.val.ints[0]
                g.defFrame.top = g.clp.val.ints[1]
            }
        } else if opt == SamePositionOpt {
            g.defFrame.left = -1
            g.defFrame.top = -1
        } else if opt == 0x74 {
            markFrame(ref g, ChTransparent)
            if g.clp.negated {
                g.defFrame.transparent.haspixel = 255
            } else {
                var c = g.clp.val.cs[0]
                g.defFrame.transparent = c
                if c.haspixel != 0 {
                    g.defFrame.transparent.haspixel = 2
                } else {
                    g.defFrame.transparent.haspixel = 1
                }
            }
        } else if opt == SameTransparentOpt {
            g.defFrame.transparent.haspixel = 0
        } else if opt == BackgroundOpt {
            markOutput(ref g, ChBackground)
            if g.clp.negated {
                g.defOutput.background.haspixel = 2
                g.defOutput.background.pixel = 0
            } else {
                var c = g.clp.val.cs[0]
                g.defOutput.background = c
                if c.haspixel != 0 {
                    g.defOutput.background.haspixel = 2
                } else {
                    g.defOutput.background.haspixel = 1
                }
            }
        } else if opt == SameBackgroundOpt {
            markOutput(ref g, ChBackground)
            g.defOutput.background.haspixel = 0
        } else if opt == MaxScreenOpt {
            if g.clp.negated {
                g.maxScreenWidth = GifMaxScreenWidth
                g.maxScreenHeight = GifMaxScreenHeight
            } else if g.clp.val.ints[0] <= 0 || g.clp.val.ints[1] <= 0 {
                clpOptionError(ref g, "argument to %O must be a positive WxH", read List<string>())
                badOption = true
            } else {
                g.maxScreenWidth = g.clp.val.ints[0]
                g.maxScreenHeight = g.clp.val.ints[1]
            }
        } else if opt == LogicalScreenOpt {
            markOutput(ref g, ChLogicalScreen)
            if g.clp.negated {
                g.defOutput.screenMode = -1
                g.defOutput.screenWidth = 0
                g.defOutput.screenHeight = 0
            } else {
                g.defOutput.screenMode = 1
                g.defOutput.screenWidth = g.clp.val.ints[0]
                g.defOutput.screenHeight = g.clp.val.ints[1]
            }
        } else if opt == SameLogicalScreenOpt {
            markOutput(ref g, ChLogicalScreen)
            g.defOutput.screenMode = 0
            g.defOutput.screenWidth = -1
            g.defOutput.screenHeight = -1
        } else if opt == CropOpt && !g.clp.negated {
            markFrame(ref g, ChCrop)
            var crop = copyCrop(ref g, g.defFrame.crop)
            g.crops[crop].specX = g.clp.val.ints[0]
            g.crops[crop].specY = g.clp.val.ints[1]
            g.crops[crop].specW = g.clp.val.ints[2]
            g.crops[crop].specH = g.clp.val.ints[3]
            g.defFrame.crop = crop
        } else if opt == CropOpt || opt == SameCropOpt {
            g.defFrame.crop = None
        } else if opt == CropTransparencyOpt {
            if !g.clp.negated {
                var crop = copyCrop(ref g, g.defFrame.crop)
                g.crops[crop].transparentEdges = true
                g.defFrame.crop = crop
            } else if g.defFrame.crop != None && g.crops[g.defFrame.crop].transparentEdges {
                var crop = copyCrop(ref g, g.defFrame.crop)
                g.crops[crop].transparentEdges = false
                g.defFrame.crop = crop
            }
        } else if opt == NoExtensionsOpt {
            g.defFrame.noExtensionsFlag |= NoexfGeneric | NoexfApp
        } else if opt == NoAppExtensionsOpt {
            g.defFrame.noExtensionsFlag |= NoexfApp
        } else if opt == SameExtensionsOpt {
            g.defFrame.noExtensionsFlag &= ~NoexfGeneric & ~NoexfApp
        } else if opt == SameAppExtensionsOpt {
            g.defFrame.noExtensionsFlag &= ~NoexfApp
        } else if opt == ExtensionOpt {
            if !handleExtension(ref g, false) {
                badOption = true
            }
        } else if opt == AppExtensionOpt {
            if !handleExtension(ref g, true) {
                badOption = true
            }
        } else if opt == FlipHorizOpt {
            markFrame(ref g, ChFlip)
            g.defFrame.flipHorizontal = !g.clp.negated
        } else if opt == FlipVertOpt {
            markFrame(ref g, ChFlip)
            g.defFrame.flipVertical = !g.clp.negated
        } else if opt == NoFlipOpt {
            g.defFrame.flipHorizontal = false
            g.defFrame.flipVertical = false
        } else if opt == NoRotateOpt {
            g.defFrame.rotation = 0
        } else if opt == Rotate90Opt {
            markFrame(ref g, ChRotate)
            g.defFrame.rotation = 1
        } else if opt == Rotate180Opt {
            markFrame(ref g, ChRotate)
            g.defFrame.rotation = 2
        } else if opt == Rotate270Opt {
            markFrame(ref g, ChRotate)
            g.defFrame.rotation = 3
        } else if opt == 0x64 {
            markFrame(ref g, ChDelay)
            if g.clp.negated {
                g.defFrame.delay = 0
            } else if g.clp.val.i < 0 || g.clp.val.i > GifMaxDelay {
                error(ref g, 0, "delay must be between 0 and 65535", read List<string>())
            } else {
                g.defFrame.delay = g.clp.val.i
            }
        } else if opt == SameDelayOpt {
            g.defFrame.delay = -1
        } else if opt == DisposalOpt {
            markFrame(ref g, ChDisposal)
            if g.clp.negated {
                g.defFrame.disposal = GifDisposalNone
            } else if g.clp.val.i < 0 || g.clp.val.i > 7 {
                error(ref g, 0, "disposal must be between 0 and 7", read List<string>())
            } else {
                g.defFrame.disposal = g.clp.val.i
            }
        } else if opt == SameDisposalOpt {
            g.defFrame.disposal = -1
        } else if opt == 0x6C {
            markOutput(ref g, ChLoopcount)
            if g.clp.negated {
                g.defOutput.loopcount = -1
            } else if g.clp.haveVal && (g.clp.val.i < 0 || g.clp.val.i > 65535) {
                error(ref g, 0, "loopcount must be between 0 and 65535", read List<string>())
            } else if g.clp.haveVal {
                g.defOutput.loopcount = g.clp.val.i
            } else {
                g.defOutput.loopcount = 0
            }
        } else if opt == SameLoopcountOpt {
            markOutput(ref g, ChLoopcount)
            g.defOutput.loopcount = -2
        } else if opt == OptimizeOpt {
            g.nextOutput |= 1 << ChOptimize
            int o = 1
            if g.clp.negated || (g.clp.haveVal && g.clp.val.i < 0) {
                o = 0
            } else if g.clp.haveVal {
                o = g.clp.val.i
            }
            if o > GtOptMask && (o & 1) != 0 {
                g.defOutput.optimizing |= o - 1
            } else if o > GtOptMask {
                g.defOutput.optimizing &= ~o
            } else {
                g.defOutput.optimizing = (g.defOutput.optimizing & ~GtOptMask) | o
            }
        } else if opt == UnoptimizeOpt {
            g.nextInput |= 1 << ChUnoptimize
            g.unoptimizing = !g.clp.negated
        } else if opt == ThreadsOpt {
            if g.clp.negated {
                g.threadCount = 0
            } else if g.clp.haveVal {
                if g.clp.val.u > 128 {
                    g.threadCount = 128
                } else {
                    g.threadCount = (int)g.clp.val.u
                }
            } else {
                g.threadCount = GifsicleDefaultThreadCount
            }
        } else if opt == CarefulOpt {
            if g.clp.negated {
                g.gifWriteInfo.flags = 0
            } else {
                g.gifWriteInfo.flags = GifWriteCarefulMinCodeSize | GifWriteEagerClear
            }
        } else if opt == ChangeColorOpt {
            g.nextInput |= 1 << ChChangeColor
            if g.clp.negated {
                deleteColorTransforms(ref g.inputTransforms, 1)
            } else if g.clp.val.cs[1].haspixel != 0 {
                error(ref g, 0, "COLOR2 must be in RGB format in %<--change-color COLOR1 COLOR2%>", read List<string>())
            } else {
                g.inputTransforms.add(ColorTransform { kind = 1, from = g.clp.val.cs[0], to = g.clp.val.cs[1], command = "" })
            }
        } else if opt == ColorTransformOpt {
            g.nextOutput |= 1 << ChColorTransform
            if g.clp.negated {
                deleteColorTransforms(ref g.outputTransforms, 2)
            } else {
                g.outputTransforms.add(ColorTransform { kind = 2, from = noColor(), to = noColor(), command = g.clp.vstr.clone() })
            }
        } else if opt == ColormapOpt {
            markOutput(ref g, ChColormap)
            if g.clp.negated {
                g.defOutput.colormapSize = 0
            } else {
                g.defOutput.colormapSize = g.clp.val.i
                if g.defOutput.colormapSize < 2 || g.defOutput.colormapSize > 256 {
                    clpOptionError(ref g, "argument to %O must be between 2 and 256", read List<string>())
                    badOption = true
                }
            }
        } else if opt == GrayOpt {
            markOutput(ref g, ChUseColormap)
            gifDeleteColormap(ref g, g.defOutput.colormapFixed)
            setNewFixedColormap(ref g, "gray", false)
        } else if opt == UseColormapOpt || opt == UseExactColormapOpt {
            markOutput(ref g, ChUseColormap)
            gifDeleteColormap(ref g, g.defOutput.colormapFixed)
            if g.clp.negated {
                g.defOutput.colormapFixed = None
            } else {
                var name = g.clp.vstr.clone()
                setNewFixedColormap(ref g, read name, opt == UseExactColormapOpt)
            }
        } else if opt == ColormapAlgorithmOpt {
            markOutput(ref g, ChColormapMethod)
            g.defOutput.colormapAlgorithm = g.clp.val.i
        } else if opt == DitherOpt {
            string name = "default"
            if g.clp.negated {
                name = "none"
            } else if g.clp.haveVal {
                name = g.clp.val.s.clone()
            }
            if name == "posterize" {
                name = "none"
            }
            if name != g.defOutput.ditherName && (name == "none" || g.defOutput.ditherName != "default") {
                markOutput(ref g, ChDither)
            }
            g.nextOutput |= 1 << ChDither
            if setDitherType(ref g.defOutput, read name) < 0 {
                clpOptionError(ref g, "%<%s%> is not a valid dither", read List<string> { name.clone() })
                badOption = true
            } else {
                g.defOutput.ditherName = name
            }
        } else if opt == GammaOpt {
            if g.clp.negated {
                markOutput(ref g, ChGamma)
                g.defOutput.colormapGammaType = KcGammaNumeric
                g.defOutput.colormapGamma = 1.0
            } else {
                var s = g.clp.val.s.clone()
                var lower = s.toLower()
                if s.asBytes().length() == 4 && lower == "srgb" {
                    markOutput(ref g, ChGamma)
                    g.defOutput.colormapGammaType = KcGammaSrgb
                } else if s.asBytes().length() == 5 && lower == "oklab" {
                    markOutput(ref g, ChGamma)
                    g.defOutput.colormapGammaType = KcGammaOklab
                } else {
                    var d = strtodDecimal(s.asBytes(), 0)
                    if d.end != 0 && d.end >= s.asBytes().length() && d.value > 0.0 && d.value.isFinite() {
                        markOutput(ref g, ChGamma)
                        g.defOutput.colormapGammaType = KcGammaNumeric
                        g.defOutput.colormapGamma = d.value
                    } else {
                        clpOptionError(ref g, "invalid gamma %<%s%> (want srgb or a positive number)", read List<string> { s.clone() })
                        badOption = true
                    }
                }
            }
        } else if opt == ResizeOpt || opt == ResizeFitOpt || opt == ResizeTouchOpt {
            markOutput(ref g, ChResize)
            if g.clp.negated {
                g.defOutput.scaling = GtScalingNone
            } else if g.clp.val.ints[0] <= 0 && g.clp.val.ints[1] <= 0 {
                error(ref g, 0, "one of W and H must be positive in %<%s WxH%>", read List<string> { clpCurOptionName(read g.clp) })
                g.defOutput.scaling = GtScalingNone
            } else {
                g.defOutput.scaling = GtScalingResize
                g.defOutput.resizeWidth = g.clp.val.ints[0]
                g.defOutput.resizeHeight = g.clp.val.ints[1]
                g.defOutput.resizeFlags = 0
                if opt != ResizeOpt {
                    g.defOutput.resizeFlags |= GtResizeFit
                }
                if opt == ResizeFitOpt {
                    g.defOutput.resizeFlags |= GtResizeFitDown
                }
            }
        } else if opt == ResizeWidthOpt || opt == ResizeHeightOpt || opt == ResizeFitWidthOpt || opt == ResizeFitHeightOpt ||
            opt == ResizeTouchWidthOpt || opt == ResizeTouchHeightOpt {
            markOutput(ref g, ChResize)
            if g.clp.negated {
                g.defOutput.scaling = GtScalingNone
            } else if g.clp.val.u > 65535 {
                error(ref g, 0, "%s argument must be at most 65535", read List<string> { clpCurOptionName(read g.clp) })
            } else if g.clp.val.u == 0 {
                error(ref g, 0, "%s argument must be positive", read List<string> { clpCurOptionName(read g.clp) })
                g.defOutput.scaling = GtScalingNone
            } else {
                var dimen = int[2] { 0, 0 }
                if opt == ResizeHeightOpt || opt == ResizeFitHeightOpt {
                    dimen[1] = (int)g.clp.val.u
                } else {
                    dimen[0] = (int)g.clp.val.u
                }
                g.defOutput.scaling = GtScalingResize
                g.defOutput.resizeWidth = dimen[0]
                g.defOutput.resizeHeight = dimen[1]
                g.defOutput.resizeFlags = 0
                if opt != ResizeWidthOpt && opt != ResizeHeightOpt {
                    g.defOutput.resizeFlags |= GtResizeFit
                }
                if opt == ResizeFitWidthOpt || opt == ResizeFitHeightOpt {
                    g.defOutput.resizeFlags |= GtResizeFitDown
                }
            }
        } else if opt == ScaleOpt {
            markOutput(ref g, ChResize)
            if g.clp.negated {
                g.defOutput.scaling = GtScalingNone
            } else if g.clp.val.ds[0] <= 0.0 || g.clp.val.ds[1] <= 0.0 {
                error(ref g, 0, "%s X and Y factors must be positive", read List<string> { clpCurOptionName(read g.clp) })
                g.defOutput.scaling = GtScalingNone
            } else {
                g.defOutput.scaling = GtScalingScale
                g.defOutput.scaleX = g.clp.val.ds[0]
                g.defOutput.scaleY = g.clp.val.ds[1]
                g.defOutput.resizeFlags = 0
            }
        } else if opt == ResizeGeometryOpt {
            markOutput(ref g, ChResize)
            if g.clp.negated {
                g.defOutput.scaling = GtScalingNone
            } else {
                var s = g.clp.val.s.clone()
                if !parseResizeGeometryOpt(ref g, read s) {
                    badOption = true
                }
            }
        } else if opt == ResizeMethodOpt {
            markOutput(ref g, ChResizeMethod)
            g.defOutput.scaleMethod = g.clp.val.i
        } else if opt == ResizeColorsOpt {
            markOutput(ref g, ChScaleColors)
            if g.clp.negated {
                g.defOutput.scaleColors = 0
            } else {
                g.defOutput.scaleColors = g.clp.val.i
            }
            if g.defOutput.scaleColors < 0 {
                error(ref g, 0, "%s must be nonnegative", read List<string> { clpCurOptionName(read g.clp) })
                g.defOutput.scaleColors = 0
            } else if g.defOutput.scaleColors > 256 {
                error(ref g, 0, "%s can be at most 256", read List<string> { clpCurOptionName(read g.clp) })
                g.defOutput.scaleColors = 256
            }
        } else if opt == LossyOpt {
            if g.clp.haveVal && g.clp.val.i < 0 {
                error(ref g, 0, "%s must be nonnegative", read List<string> { clpCurOptionName(read g.clp) })
            } else if g.clp.haveVal {
                g.gifWriteInfo.loss = g.clp.val.i
            } else {
                g.gifWriteInfo.loss = 20
            }
        } else if opt == NoWarningsOpt {
            g.msgs.noWarnings = !g.clp.negated
        } else if opt == WarningsOpt {
            g.msgs.noWarnings = g.clp.negated
        } else if opt == IgnoreErrorsOpt {
            g.msgs.noIgnoreErrors = g.clp.negated
        } else if opt == ConserveMemoryOpt {
            markOutput(ref g, ChMemory)
            if g.clp.negated {
                g.defOutput.conserveMemory = -1
            } else {
                g.defOutput.conserveMemory = 1
            }
        } else if opt == MultifileOpt {
            if g.clp.negated {
                g.gifReadFlags &= ~GifReadTrailingGarbageOk
            } else {
                g.gifReadFlags |= GifReadTrailingGarbageOk
                g.nextfile = false
            }
        } else if opt == NextfileOpt {
            if g.clp.negated {
                g.gifReadFlags &= ~GifReadTrailingGarbageOk
            } else {
                g.gifReadFlags |= GifReadTrailingGarbageOk
                g.nextfile = true
            }
        } else if opt == VersionOpt {
            var s = $"LCDF Gifsicle {Version}\nCopyright (C) 1997-2025 Eddie Kohler\nThis is free software; see the source for copying conditions.\nThere is NO warranty, not even for merchantability or fitness for a\nparticular purpose.\n".toString()
            writeOutput(ref g, s.asBytes())
            return 0
        } else if opt == HelpOpt {
            usage(ref g)
            return 0
        } else if opt == OutputOpt {
            markOutput(ref g, ChOutput)
            if g.clp.vstr == "-" {
                g.defOutput.hasOutputName = false
                g.defOutput.outputName = ""
            } else {
                g.defOutput.hasOutputName = true
                g.defOutput.outputName = g.clp.vstr.clone()
            }
        } else if opt == ClpNotOption {
            var arg = g.clp.vstr.clone()
            int fa = 0
            if arg.startsWith("#") {
                fa = frameArgument(ref g, read arg)
            }
            if fa < 0 {
                badOption = true
            } else if fa == 0 {
                inputDone(ref g)
                inputStream(ref g, read arg)
            }
        } else if opt == ClpDone {
            break
        } else if opt == ClpBadOption {
            badOption = true
        }
        if badOption {
            shortUsage(ref g)
            return 1
        }
    }

    if g.nextOutput != 0 {
        combineOutputOptions(ref g)
    }
    if g.filesGiven == 0 {
        inputStream(ref g, null)
    }
    if g.msgs.stopping {
        return 1
    }
    frameChangeDone(ref g)
    inputDone(ref g)
    if (g.mode == Merging && g.msgs.errorCount == 0) || g.mode == Infoing {
        outputFrames(ref g)
    }
    verboseEndline(ref g)
    printUselessOptions(ref g, "frame", g.nextFrame, 0)
    printUselessOptions(ref g, "input", g.nextInput, 1)
    if g.anyOutputSuccessful {
        printUselessOptions(ref g, "output", g.activeNextOutput, 2)
    }
    if g.msgs.errorCount != 0 {
        return 1
    }
    return 0
}

string optionTypeName(int kind, int i) {
    if kind == 0 {
        return frameOptionType(i)
    } else if kind == 1 {
        return inputOptionType(i)
    }
    return outputOptionType(i)
}
